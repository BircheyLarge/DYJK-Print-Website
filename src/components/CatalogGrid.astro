---
import type { CatalogItem } from '../data/catalog';

interface Props {
  items: ReadonlyArray<CatalogItem>;
}
const { items } = Astro.props;
---

<div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
  {
    items.map((item) => (
      <div class="rounded-card bg-white p-6 shadow-card">
        <h2 class="text-card font-semibold text-brand-ink">{item.name}</h2>
        <p class="mt-2 text-ui leading-normal text-brand-slate">{item.blurb}</p>
      </div>
    ))
  }
</div>
