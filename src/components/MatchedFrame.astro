---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  image: ImageMetadata;
  /** Rendered width of the photo inside the mat; must match the grid. */
  sizes: string;
  loading?: 'eager' | 'lazy';
  fetchpriority?: 'high';
}

// Direction C's frame: a matched 3:2 shot on a light mat with a hairline
// border, so every product sits in the same frame. Decorative: the card's
// own text names the product.
const { image, sizes, loading = 'lazy', fetchpriority } = Astro.props;
---

<span class="block border border-rule bg-brand-surface p-3">
  <Picture
    src={image}
    alt=""
    formats={['avif', 'webp']}
    widths={[320, 480, 720, 960]}
    sizes={sizes}
    loading={loading}
    fetchpriority={fetchpriority}
    class="aspect-3/2 w-full bg-brand-surface object-cover"
  />
</span>
