---
/*
 * QuoteCta — the closing conversion band (ink tone). "Request a Quote" is the
 * one reserved-accent action; on the ink band the accent's only valid form is
 * this filled+white-label button, which is exactly what primary renders.
 */
import Section from './Section.astro';
import Button from './Button.astro';
import { QUOTE_PATH, SITE } from '../consts';

interface Props {
  heading?: string;
  text?: string;
}
const {
  heading = 'Ready to start your print project?',
  text = "Send us your specs and artwork. We'll get you a fast quote and a clear production timeline.",
} = Astro.props;
---

<Section tone="ink" align="center" title={heading} lead={text}>
  <div class="flex flex-wrap items-center justify-center gap-4">
    <Button href={QUOTE_PATH} variant="primary">Request a Quote</Button>
    <Button href={`tel:${SITE.phone}`} variant="outline" onInk>
      Call {SITE.phoneDisplay}
    </Button>
  </div>
</Section>
