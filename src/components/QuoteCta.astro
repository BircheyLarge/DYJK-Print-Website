---
import { QUOTE_PATH, SITE } from '../consts';

interface Props {
  heading?: string;
  text?: string;
}
const {
  heading = 'Ready to start your print project?',
  text = "Send us your specs and artwork. We'll get you a fast quote and a clear production timeline.",
} = Astro.props;
---

<section class="bg-brand-ink">
  <div class="mx-auto max-w-6xl px-4 py-16 text-center">
    <h2 class="text-3xl font-bold tracking-tight text-white">{heading}</h2>
    <p class="mx-auto mt-4 max-w-xl text-slate-300">{text}</p>
    <div class="mt-8 flex flex-wrap items-center justify-center gap-4">
      <a
        href={QUOTE_PATH}
        class="inline-block rounded-md bg-brand-blue px-6 py-3 text-base font-semibold text-white transition-colors hover:bg-brand-blue-dark"
      >
        Request a Quote
      </a>
      <a
        href={`tel:${SITE.phone}`}
        class="inline-block rounded-md border border-slate-600 px-6 py-3 text-base font-semibold text-white transition-colors hover:border-white"
      >
        Call {SITE.phoneDisplay}
      </a>
    </div>
  </div>
</section>
