---
import { QUOTE_PATH, SITE } from '../consts';

interface Props {
  /** Product pages ask "Need <product>?"; everywhere else keeps the default. */
  heading?: string;
}
const { heading = 'Ready to start your print project?' } = Astro.props;
---

<section class="on-dark bg-brand-blue-dark px-4 py-14 text-center md:py-18">
  <h2
    class="mx-auto max-w-4xl font-display text-cta-sm font-bold text-on-dark md:text-cta"
  >
    {heading}
  </h2>
  <p
    class="mx-auto mt-4 max-w-xl text-base leading-normal text-on-dark-soft md:text-lg"
  >
    Send us your specs and artwork. We'll get you a fast quote and a clear
    production timeline.
  </p>
  <div class="mt-7 flex flex-wrap items-center justify-center gap-3">
    <a href={QUOTE_PATH} class="btn btn-solid">Request a Quote</a>
    <a href={`mailto:${SITE.email}`} class="btn btn-ghost">
      Email {SITE.email}
    </a>
    {
      SITE.phone && (
        <a href={`tel:${SITE.phone.e164}`} class="btn btn-ghost">
          Call {SITE.phone.display}
        </a>
      )
    }
  </div>
</section>
