---
// Typography for rendered markdown. Tailwind's preflight resets element
// styles and the typography plugin isn't installed, so this restores a small
// rhythm from the site's own utilities. Body copy matches the detail pages
// (text-lg, leading-relaxed, brand-slate).
---

<div class="prose"><slot /></div>

<style>
  @reference '../styles/global.css';

  .prose > :global(:first-child) {
    @apply mt-0;
  }
  .prose :global(h2) {
    @apply mt-12 text-2xl font-bold tracking-tight text-brand-ink;
  }
  .prose :global(h3) {
    @apply mt-8 text-lg font-semibold text-brand-ink;
  }
  .prose :global(:is(p, ul, ol)) {
    @apply mt-4 text-lg leading-relaxed text-brand-slate;
  }
  .prose :global(ul) {
    @apply list-disc pl-6;
  }
  .prose :global(ol) {
    @apply list-decimal pl-6;
  }
  .prose :global(li + li) {
    @apply mt-2;
  }
  .prose :global(strong) {
    @apply font-semibold text-brand-ink;
  }
  /* Underlined: brand-blue alone doesn't separate a link from slate text. */
  .prose :global(a) {
    @apply text-brand-blue underline underline-offset-2 hover:text-brand-blue-dark;
  }
</style>
