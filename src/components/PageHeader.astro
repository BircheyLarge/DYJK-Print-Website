---
interface Props {
  title: string;
  subtitle?: string;
  eyebrow?: string;
}
const { title, subtitle, eyebrow } = Astro.props;
---

<section class="bg-brand-surface">
  <div class="mx-auto max-w-6xl px-4 py-16 sm:py-20">
    {
      eyebrow && (
        <p class="text-sm font-semibold uppercase tracking-wider text-brand-blue">
          {eyebrow}
        </p>
      )
    }
    <h1
      class="mt-3 max-w-3xl text-4xl font-bold tracking-tight text-brand-ink sm:text-5xl"
    >
      {title}
    </h1>
    {
      subtitle && (
        <p class="mt-4 max-w-2xl text-lg text-brand-muted">{subtitle}</p>
      )
    }
  </div>
</section>
