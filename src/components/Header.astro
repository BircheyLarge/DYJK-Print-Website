---
import Lockup from './Lockup.astro';
import { NAV, QUOTE_PATH, SITE } from '../consts';

const path = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? path === '/' : path.startsWith(href);
---

<header class="on-dark sticky top-0 z-50 bg-brand-blue-dark text-on-dark">
  <nav
    class="mx-auto flex min-h-18 max-w-6xl items-center justify-between gap-6 px-4 md:min-h-21"
    aria-label="Primary"
  >
    <a href="/" class="shrink-0" aria-label={`${SITE.name} home`}>
      <Lockup width={220} phoneWidth={164} loading="eager" />
    </a>

    <ul class="hidden items-center gap-7 lg:flex">
      {
        NAV.map((item) => (
          <li>
            <a
              href={item.href}
              aria-current={isActive(item.href) ? 'page' : undefined}
              class:list={[
                'border-b-2 pb-1 text-ui font-medium transition-colors hover:text-on-dark',
                isActive(item.href)
                  ? 'border-on-dark text-on-dark'
                  : 'border-transparent text-on-dark-soft',
              ]}
            >
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>

    <div class="flex items-center gap-3">
      <a href={QUOTE_PATH} class="btn btn-solid hidden md:inline-flex">
        Request a Quote
      </a>
      <button
        type="button"
        id="nav-toggle"
        class="inline-flex size-11 items-center justify-center rounded-control lg:hidden"
        aria-expanded="false"
        aria-controls="mobile-nav"
        aria-label="Toggle navigation menu"
      >
        <svg
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          aria-hidden="true"
        >
          <line x1="3" y1="6" x2="21" y2="6"></line>
          <line x1="3" y1="12" x2="21" y2="12"></line>
          <line x1="3" y1="18" x2="21" y2="18"></line>
        </svg>
      </button>
    </div>
  </nav>

  <div id="mobile-nav" class="px-4 pb-5 lg:hidden" hidden>
    <ul class="mx-auto max-w-6xl">
      {
        NAV.map((item) => (
          <li>
            <a
              href={item.href}
              aria-current={isActive(item.href) ? 'page' : undefined}
              class:list={[
                'block px-2 py-3 text-base font-medium hover:text-on-dark',
                isActive(item.href) ? 'text-on-dark' : 'text-on-dark-soft',
              ]}
            >
              {item.label}
            </a>
          </li>
        ))
      }
      <li class="mt-2">
        <a href={QUOTE_PATH} class="btn btn-solid w-full">Request a Quote</a>
      </li>
    </ul>
  </div>
</header>

<script>
  const toggle = document.getElementById('nav-toggle');
  const menu = document.getElementById('mobile-nav');

  const setOpen = (open: boolean) => {
    toggle?.setAttribute('aria-expanded', String(open));
    if (menu) menu.hidden = !open;
  };
  const isOpen = () => toggle?.getAttribute('aria-expanded') === 'true';

  toggle?.addEventListener('click', () => setOpen(!isOpen()));
  // Escape closes the menu and puts focus back on the button that opened it.
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && isOpen()) {
      setOpen(false);
      toggle?.focus();
    }
  });
</script>
