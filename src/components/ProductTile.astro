---
import MatchedFrame from './MatchedFrame.astro';
import { MATCHED } from '../data/matched';

interface Props {
  slug: string;
  title: string;
  description: string;
  /** Rendered width of the photo inside the frame; must match the grid. */
  sizes: string;
  loading?: 'eager' | 'lazy';
  fetchpriority?: 'high';
}

const {
  slug,
  title,
  description,
  sizes,
  loading = 'lazy',
  fetchpriority,
} = Astro.props;
// Every product has a matched shot (tests/unit/matched.test.ts); a new one
// shows the drawn booklet in the same frame until its photo lands.
const shot = MATCHED[slug];
---

<a href={`/products/${slug}/`} class="group block">
  {
    shot ? (
      <MatchedFrame
        image={shot}
        sizes={sizes}
        loading={loading}
        fetchpriority={fetchpriority}
      />
    ) : (
      <span class="block border border-rule bg-brand-surface p-3">
        <span
          data-placeholder
          class="flex aspect-3/2 items-center justify-center text-brand-blue"
        >
          <svg
            viewBox="0 0 120 80"
            class="h-1/2 w-auto"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M26 59v3c11-1.5 23-1 34 3 11-4 23-4.5 34-3v-3" />
            <path
              fill="white"
              d="M60 22c-11-4-23-4.5-34-3v40c11-1.5 23-1 34 3zM60 22c11-4 23-4.5 34-3v40c-11-1.5-23-1-34 3z"
            />
            <path d="M32 28l22 1.2M32 34l22 1.2M32 40l22 1.2M32 46l15 .8" />
          </svg>
        </span>
      </span>
    )
  }
  <h2
    class="mt-4 text-card font-semibold text-brand-ink group-hover:text-brand-blue"
  >
    {title}
  </h2>
  <p class="mt-2 text-ui leading-normal text-brand-slate">{description}</p>
  <span class="mt-3 inline-block text-sm font-semibold text-brand-blue">
    Learn more&nbsp;<span aria-hidden="true">→</span>
  </span>
</a>
