---
import { NAV, QUOTE_PATH, SITE } from '../consts';
const year = new Date().getFullYear();
---

<footer class="border-t border-slate-200 bg-brand-surface">
  <div
    class="mx-auto grid max-w-6xl gap-8 px-4 py-12 sm:grid-cols-2 lg:grid-cols-4"
  >
    <div class="sm:col-span-2 lg:col-span-1">
      <img
        src="/brand/logo.png"
        width="299"
        height="78"
        alt={`${SITE.name} — ${SITE.tagline}`}
        class="h-9 w-auto"
      />
      <p class="mt-4 max-w-xs text-sm text-brand-muted">
        {SITE.tagline}. Commercial printing shipped nationwide — work with us
        from anywhere in the US.
      </p>
    </div>

    <div>
      <h2 class="text-sm font-semibold text-brand-ink">Explore</h2>
      <ul class="mt-3 space-y-2">
        {
          NAV.map((item) => (
            <li>
              <a
                href={item.href}
                class="text-sm text-brand-muted hover:text-brand-blue"
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <div>
      <h2 class="text-sm font-semibold text-brand-ink">Get a quote</h2>
      <p class="mt-3 text-sm text-brand-muted">
        Tell us about your project and we'll turn it around fast.
      </p>
      <a
        href={QUOTE_PATH}
        class="mt-3 inline-block rounded-md bg-brand-blue px-4 py-2 text-sm font-semibold text-white hover:bg-brand-blue-dark"
      >
        Request a Quote
      </a>
    </div>

    <div>
      <h2 class="text-sm font-semibold text-brand-ink">Contact</h2>
      <ul class="mt-3 space-y-2 text-sm text-brand-muted">
        <li>
          <a href={`tel:${SITE.phone}`} class="hover:text-brand-blue"
            >{SITE.phoneDisplay}</a
          >
        </li>
        <li>
          <a href={`mailto:${SITE.email}`} class="hover:text-brand-blue"
            >{SITE.email}</a
          >
        </li>
      </ul>
    </div>
  </div>

  <div class="border-t border-slate-200">
    <p class="mx-auto max-w-6xl px-4 py-4 text-xs text-brand-muted">
      &copy; {year}
      {SITE.name}. All rights reserved.
    </p>
  </div>
</footer>
