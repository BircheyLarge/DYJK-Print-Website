---
import ProductFrame from './ProductFrame.astro';
import {
  audiences,
  benefits,
  products,
  proofs,
  quoteHref,
  recentWork,
  steps,
  workHref,
} from './content';

const productSizes =
  '(min-width: 50.0625rem) 240px, (min-width: 40rem) 42vw, 46vw';
const recentSizes = '(min-width: 50.0625rem) 420px, 88vw';
---

<div class="draft">
  <section class="db-hero on-dark">
    <div class="db-mark" aria-hidden="true">
      <svg viewBox="0 0 200 200">
        <circle
          cx="100"
          cy="100"
          r="78"
          fill="none"
          stroke="#00a0e4"
          stroke-width="3"></circle>
        <circle
          cx="100"
          cy="100"
          r="48"
          fill="none"
          stroke="#c4006a"
          stroke-width="3"></circle>
        <circle cx="100" cy="100" r="14" fill="#ffe600"></circle>
        <path d="M100 8 V192 M8 100 H192" stroke="#ffffff" stroke-width="1.5"
        ></path>
      </svg>
    </div>
    <div class="d-wrap db-hero-inner">
      <p class="d-kicker db-kicker">
        <span class="d-dots" aria-hidden="true">
          <i class="d-dot-c"></i>
          <i class="d-dot-m"></i>
          <i class="d-dot-y"></i>
          <i class="d-dot-k-light"></i>
        </span>
        Press check
      </p>
      <h1 class="db-title">Color that holds for the whole run.</h1>
      <p class="d-sub db-sub">Offset or digital, shipped nationwide.</p>
      <div class="d-actions">
        <a href={quoteHref} class="press-cta">Get a free quote</a>
        <a href={workHref} class="btn btn-ghost">See our work</a>
      </div>
      <ul class="db-proofs">
        {proofs.map((proof) => <li>{proof}</li>)}
      </ul>
    </div>
  </section>

  <section class="d-section">
    <div class="d-wrap db-why-grid">
      <h2 class="d-h2">Why businesses choose DYJK</h2>
      <ol class="db-benefits">
        {
          benefits.map((benefit, index) => (
            <li>
              <span class="num">{String(index + 1).padStart(2, '0')}</span>
              <div>
                <h3>{benefit.title}</h3>
                <p>{benefit.body}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="d-section db-process on-dark">
    <div class="d-wrap">
      <h2 class="d-h2">How it works</h2>
      <ol class="db-steps">
        {
          steps.map((step, index) => (
            <li>
              <p class="step">Step {index + 1}</p>
              <h3>{step.name}</h3>
              <p>{step.body}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="d-section db-products on-dark">
    <div class="d-wrap">
      <div class="da-headrow">
        <h2 class="d-h2">The products</h2>
        <a class="db-all" href="/products/">All products</a>
      </div>
      <p class="d-lead">
        One set of pieces, from the card in a pocket to the mailer in a box.
      </p>
      <ul class="d-product-grid">
        {
          products.map((piece) => (
            <li>
              <ProductFrame piece={piece} sizes={productSizes} tone="light" />
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="d-section">
    <div class="d-wrap">
      <h2 class="d-h2">Who we print for</h2>
      <ul class="db-audiences">
        {
          audiences.map((audience) => (
            <li>
              <h3>{audience.name}</h3>
              <p>{audience.body}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="d-section db-recent">
    <div class="d-wrap">
      <h2 class="d-h2">Recent work</h2>
      <ul class="db-recent-grid">
        {
          recentWork.map((piece) => (
            <li>
              <ProductFrame piece={piece} sizes={recentSizes} />
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="d-section db-close on-dark">
    <div class="db-close-marks" aria-hidden="true">
      <span></span><span></span>
    </div>
    <div class="d-wrap">
      <h2 class="d-h2">Send the job.</h2>
      <p>
        Share the piece and where it ships. You get a quote, then a proof,
        before anything prints.
      </p>
      <a href={quoteHref} class="press-cta">Get a free quote</a>
    </div>
  </section>
</div>
