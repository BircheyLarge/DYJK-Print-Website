---
import CallLink from './CallLink.astro';
import HeroPiece from './HeroPiece.astro';
import ProductFrame from './ProductFrame.astro';
import {
  audiences,
  benefits,
  closeHeading,
  closeLine,
  heroHeadline,
  heroLight,
  heroSubhead,
  products,
  proofs,
  quoteHref,
  recentWork,
  steps,
  workHref,
} from './content';

const productSizes =
  '(min-width: 50.0625rem) 240px, (min-width: 40rem) 42vw, 46vw';
const recentSizes = '(min-width: 50.0625rem) 520px, 92vw';
const heroSizes = '(min-width: 68.8125rem) 220px, 30vw';
---

<div class="draft">
  <section class="da-hero">
    <div class="da-copy">
      <p class="d-kicker da-kicker">
        <span class="d-dots" aria-hidden="true">
          <i class="d-dot-c"></i>
          <i class="d-dot-m"></i>
          <i class="d-dot-y"></i>
          <i class="d-dot-k"></i>
        </span>
        Utah-based · Shipping nationwide
      </p>
      <h1 class="da-title">{heroHeadline}</h1>
      <p class="d-sub da-sub">{heroSubhead}</p>
      <div class="d-actions">
        <a href={quoteHref} class="btn btn-solid">Get a free quote</a>
        <a href={workHref} class="btn btn-ghost">See our work</a>
        <CallLink />
      </div>
      <ul class="da-proofs">
        {proofs.map((proof) => <li>{proof}</li>)}
      </ul>
    </div>
    <div class="da-stage">
      {
        heroLight.map((piece) => (
          <HeroPiece piece={piece} sizes={heroSizes} labeled />
        ))
      }
    </div>
  </section>

  <section class="d-section da-why">
    <div class="d-wrap">
      <h2 class="d-h2">Why businesses choose DYJK</h2>
      <ul class="da-benefits">
        {
          benefits.map((benefit) => (
            <li>
              <h3>{benefit.title}</h3>
              <p>{benefit.body}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="d-section">
    <div class="d-wrap">
      <h2 class="d-h2">How it works</h2>
      <ol class="da-steps">
        {
          steps.map((step, index) => (
            <li>
              <p class="num" aria-hidden="true">
                {String(index + 1).padStart(2, '0')}
              </p>
              <h3>{step.name}</h3>
              <p>{step.body}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="d-section da-products">
    <div class="d-wrap">
      <div class="da-headrow">
        <h2 class="d-h2">The products</h2>
        <a class="da-textlink" href="/products/">All products</a>
      </div>
      <ul class="d-product-grid">
        {
          products.map((piece) => (
            <li>
              <ProductFrame piece={piece} sizes={productSizes} />
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="d-section">
    <div class="d-wrap">
      <h2 class="d-h2">Who we print for</h2>
      <ul class="da-audiences">
        {
          audiences.map((audience) => (
            <li>
              <h3>{audience.name}</h3>
              <p>{audience.body}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="d-section da-recent">
    <div class="d-wrap">
      <h2 class="d-h2">Recent work</h2>
      <ul class="da-recent-grid">
        {
          recentWork.map((piece) => (
            <li>
              <ProductFrame piece={piece} sizes={recentSizes} />
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="d-section da-close">
    <div class="d-wrap da-close-row">
      <div>
        <h2 class="d-h2">{closeHeading}</h2>
        <p>{closeLine}</p>
      </div>
      <div class="d-close-cta">
        <a href={quoteHref} class="btn btn-solid">Get a free quote</a>
        <CallLink />
      </div>
    </div>
  </section>
</div>
