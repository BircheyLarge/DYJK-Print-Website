---
import CallLink from './CallLink.astro';
import HeroPiece from './HeroPiece.astro';
import ProductFrame from './ProductFrame.astro';
import {
  audiences,
  benefits,
  closeHeading,
  closeLine,
  heroHeadline,
  heroInk,
  heroSubhead,
  products,
  proofs,
  quoteHref,
  recentWork,
  steps,
  workHref,
} from './content';

const productSizes =
  '(min-width: 50.0625rem) 240px, (min-width: 40rem) 42vw, 46vw';
const recentSizes = '(min-width: 50.0625rem) 420px, 88vw';
const heroSizes = '(min-width: 68.8125rem) 200px, 28vw';
const plates = ['c', 'm', 'y', 'k'] as const;
const ticker =
  'Business cards · Flyers · Door hangers · Menus · Postcards · Brochures · Labels · Stickers · Folders · Letterhead · Booklets';
---

<div class="draft">
  <section class="dc-hero on-dark">
    <div class="dc-fan">
      {
        heroInk.map((piece, index) => (
          <div class="dc-fan-card" style={`--fan: ${index}`}>
            <HeroPiece piece={piece} sizes={heroSizes} />
          </div>
        ))
      }
      <div class="dc-mark" aria-hidden="true">
        <svg viewBox="0 0 200 200">
          <circle
            cx="100"
            cy="100"
            r="78"
            fill="none"
            stroke="#00a0e4"
            stroke-width="3"></circle>
          <circle
            cx="100"
            cy="100"
            r="48"
            fill="none"
            stroke="#c4006a"
            stroke-width="3"></circle>
          <circle cx="100" cy="100" r="14" fill="#ffe600"></circle>
          <path d="M100 8 V192 M8 100 H192" stroke="#ffffff" stroke-width="1.5"
          ></path>
        </svg>
      </div>
    </div>
    <div class="d-wrap dc-hero-inner">
      <p class="d-kicker dc-kicker">
        <span class="d-dots" aria-hidden="true">
          <i class="d-dot-c"></i>
          <i class="d-dot-m"></i>
          <i class="d-dot-y"></i>
          <i class="d-dot-k-light"></i>
        </span>
        Utah-based · Shipping nationwide
      </p>
      <div class="dc-lockup">
        <div class="dc-plates" aria-hidden="true">
          <span class="dc-reg dc-reg-c" data-text={heroHeadline}></span>
          <span class="dc-reg dc-reg-m" data-text={heroHeadline}></span>
          <span class="dc-reg dc-reg-y" data-text={heroHeadline}></span>
        </div>
        <h1 class="dc-title">{heroHeadline}</h1>
      </div>
      <p class="d-sub dc-sub">{heroSubhead}</p>
      <div class="d-actions">
        <a href={quoteHref} class="press-cta">Get a free quote</a>
        <a href={workHref} class="btn btn-ghost">See our work</a>
        <CallLink />
      </div>
      <ul class="dc-proofs">
        {proofs.map((proof) => <li>{proof}</li>)}
      </ul>
    </div>
  </section>

  <div class="dc-cmyk" aria-hidden="true">
    <span></span><span></span><span></span><span></span>
  </div>

  <div class="dc-ticker-band">
    <p class="dc-sr">
      Business cards, Flyers, Door hangers, Menus, Postcards, Brochures, Labels,
      Stickers, Folders, Letterhead, Booklets.
    </p>
    <div class="dc-ticker" aria-hidden="true">
      <div class="dc-ticker-track">
        <p>{ticker}</p>
        <p>{ticker}</p>
      </div>
    </div>
  </div>

  <div class="dc-sheet">
    <section class="d-section">
      <div class="d-wrap">
        <h2 class="d-h2">Why businesses choose DYJK</h2>
        <ul class="dc-benefits">
          {
            benefits.map((benefit) => (
              <li>
                <h3>{benefit.title}</h3>
                <p>{benefit.body}</p>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <section class="d-section dc-process">
      <div class="d-wrap">
        <h2 class="d-h2">How it works</h2>
        <ol class="dc-run">
          {
            steps.map((step, index) => (
              <li class={`is-${plates[index]}`}>
                <span class="dc-num">{String(index + 1).padStart(2, '0')}</span>
                <div>
                  <h3>{step.name}</h3>
                  <p>{step.body}</p>
                </div>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <section class="d-section dc-products">
      <div class="d-wrap">
        <div class="da-headrow">
          <h2 class="d-h2">The products</h2>
          <a class="dc-all" href="/products/">All products</a>
        </div>
        <p class="d-lead">
          One set of pieces, from the card in a pocket to the mailer in a box.
        </p>
        <ul class="d-product-grid">
          {
            products.map((piece) => (
              <li>
                <ProductFrame piece={piece} sizes={productSizes} />
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <section class="d-section">
      <div class="d-wrap">
        <h2 class="d-h2">Who we print for</h2>
        <ul class="dc-audiences">
          {
            audiences.map((audience) => (
              <li>
                <h3>{audience.name}</h3>
                <p>{audience.body}</p>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <section class="d-section dc-recent">
      <div class="d-wrap">
        <h2 class="d-h2">Recent work</h2>
        <ul class="dc-recent-grid">
          {
            recentWork.map((piece) => (
              <li>
                <ProductFrame piece={piece} sizes={recentSizes} />
              </li>
            ))
          }
        </ul>
      </div>
    </section>
  </div>

  <section class="d-section dc-close on-dark">
    <div class="dc-close-mark" aria-hidden="true">
      <svg viewBox="0 0 200 200">
        <circle
          cx="100"
          cy="100"
          r="78"
          fill="none"
          stroke="#00a0e4"
          stroke-width="3"></circle>
        <circle
          cx="100"
          cy="100"
          r="48"
          fill="none"
          stroke="#c4006a"
          stroke-width="3"></circle>
        <circle cx="100" cy="100" r="14" fill="#ffe600"></circle>
        <path d="M100 8 V192 M8 100 H192" stroke="#ffffff" stroke-width="1.5"
        ></path>
      </svg>
    </div>
    <div class="d-wrap">
      <h2 class="d-h2">{closeHeading}</h2>
      <p>{closeLine}</p>
      <div class="d-close-cta">
        <a href={quoteHref} class="press-cta">Get a free quote</a>
        <CallLink />
      </div>
    </div>
  </section>
</div>
