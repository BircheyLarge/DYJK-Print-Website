---
import { TICKER } from '../data/home';

// Direction C's band of product names under the hero. The moving copy is
// hidden from assistive tech, which reads the list once instead. It pauses
// on hover and holds still for reduced motion.
const line = TICKER.join(' · ');
---

<div class="ticker-band relative border-b border-rule bg-white" data-ticker>
  <p class="sr-only">{TICKER.join(', ')}.</p>
  <button type="button" class="ticker-control" aria-pressed="false">
    Pause
  </button>
  <div class="ticker" aria-hidden="true">
    <div class="track">
      <p>{line}</p>
      <p>{line}</p>
    </div>
  </div>
</div>

<script>
  const band = document.querySelector('[data-ticker]');
  const button = band?.querySelector('button');
  button?.addEventListener('click', () => {
    if (!band || !button) return;
    const paused = band.classList.toggle('is-paused');
    button.setAttribute('aria-pressed', String(paused));
    button.textContent = paused ? 'Play' : 'Pause';
  });
</script>

<style>
  .ticker {
    position: relative;
    overflow: hidden;
    height: 2.75rem;
  }

  .track {
    position: absolute;
    top: 0;
    left: 0;
    display: flex;
    width: max-content;
    animation: ticker 32s linear infinite;
  }

  .track p {
    padding: 0.75rem 1.5rem;
    font-size: var(--text-eyebrow);
    font-weight: 600;
    letter-spacing: var(--text-eyebrow--letter-spacing);
    line-height: 1.25rem;
    text-transform: uppercase;
    white-space: nowrap;
    color: var(--color-brand-ink);
  }

  .ticker-band::after {
    content: '';
    position: absolute;
    z-index: 1;
    top: 0;
    right: 0;
    width: 6.75rem;
    height: 100%;
    background: linear-gradient(90deg, rgb(255 255 255 / 0), #fff 1.35rem);
    pointer-events: none;
  }

  .ticker-control {
    position: absolute;
    z-index: 2;
    top: 50%;
    right: 0.4rem;
    transform: translateY(-50%);
    min-height: 2rem;
    padding: 0 0.7rem;
    border: 1px solid var(--color-brand-ink);
    background: #fff;
    color: var(--color-brand-ink);
    font: 600 0.75rem/1 var(--font-sans, sans-serif);
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .ticker-control:focus-visible {
    outline: 3px solid var(--color-brand-blue);
    outline-offset: 2px;
  }

  .ticker:hover .track,
  .ticker-band.is-paused .track {
    animation-play-state: paused;
  }

  @keyframes ticker {
    to {
      transform: translateX(-50%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .track {
      animation: none;
    }

    .ticker-control {
      display: none;
    }
  }
</style>
