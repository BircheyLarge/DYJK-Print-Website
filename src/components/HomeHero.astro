---
import { Picture } from 'astro:assets';
import PressDots from './PressDots.astro';
import RegistrationMark from './RegistrationMark.astro';
import { QUOTE_PATH, SITE } from '../consts';
import { FAN, HEADLINE, PROOFS, SUBHEAD } from '../data/home';

// Direction C's ink hero. The headline comes into register: three color
// plates (aria-hidden copies drawn by ::before) slide onto the white h1, so
// the words exist once for readers and search. Beside it, a fan of printed
// pieces with the registration mark.

// Fan cards are 10.5rem wide from md and 5.35rem on phones; the photo sits
// inside a 12px mat and a 1px border.
const fanSizes = '(min-width: 50.0625rem) 142px, 60px';
const PLATES = ['cyan', 'magenta', 'yellow'] as const;
const front = FAN.length - 1;
---

<section class="hero on-dark" aria-label="Introduction">
  <div class="fan">
    {
      FAN.map((piece, index) => (
        <a
          href={piece.href}
          class="fan-card"
          style={`--fan: ${index}`}
          aria-label={piece.label}
        >
          <span class="block border border-rule bg-brand-surface p-3">
            <Picture
              src={piece.image}
              alt=""
              formats={['avif', 'webp']}
              widths={[120, 180, 240, 360, 480]}
              sizes={fanSizes}
              loading="eager"
              fetchpriority={index === front ? 'high' : undefined}
              class="aspect-3/2 w-full object-cover"
            />
          </span>
        </a>
      ))
    }
    <RegistrationMark class="mark" />
  </div>

  <div class="copy">
    <p
      class="flex items-center gap-3 text-eyebrow font-semibold uppercase text-press-cyan-soft"
    >
      <PressDots />
      <span class="kicker">
        <span>Utah-based</span><span class="kicker-sep"> · </span><span
          >Shipping nationwide</span
        >
      </span>
    </p>
    <div class="lockup">
      <div class="plates" aria-hidden="true">
        {
          PLATES.map((plate) => (
            <span class={`plate plate-${plate}`} data-text={HEADLINE} />
          ))
        }
      </div>
      <h1 class="title">{HEADLINE}</h1>
    </div>
    <p
      class="mt-4 max-w-[27.5em] text-deck-sm font-medium text-on-dark-soft md:text-deck"
    >
      {SUBHEAD}
    </p>
    <div class="actions">
      <div class="buttons">
        <a href={QUOTE_PATH} class="btn btn-solid btn-lg">Get a free quote</a>
        <a href="/portfolio/" class="btn btn-ghost btn-lg">See our work</a>
      </div>
      {
        SITE.phone && (
          <a
            href={`tel:${SITE.phone.e164}`}
            class="text-sm font-medium text-on-dark-soft underline underline-offset-[0.18em] hover:text-on-dark"
          >
            or call {SITE.phone.display}
          </a>
        )
      }
    </div>
    <ul class="proofs" role="list">
      {PROOFS.map((proof) => <li>{proof}</li>)}
    </ul>
  </div>
</section>

<style>
  .hero {
    position: relative;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    background: var(--color-brand-ink);
    color: var(--color-on-dark);
  }

  .copy {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 1.5rem 1rem 1.25rem;
  }

  /* Two lines on phones, one from 25rem, set by width rather than by
     wrapping: at 390px Outfit just fits on one line and Arial doesn't. */
  .kicker {
    line-height: 1.35;
    white-space: nowrap;
  }

  .kicker > span {
    display: block;
  }

  .kicker > .kicker-sep {
    display: none;
  }

  @media (min-width: 25rem) {
    .kicker {
      line-height: inherit;
    }

    .kicker > span,
    .kicker > .kicker-sep {
      display: inline;
    }
  }

  /* The h1 and its plates share one box, so the copies wrap like it.
     Measures here are in em, not ch: Outfit's zero is a quarter wider than
     its fallback's, so a ch box would change width when the font arrives. */
  .lockup {
    position: relative;
    margin-top: 1rem;
    max-width: 7.33em;
    font-size: var(--text-hero);
    font-weight: 700;
    letter-spacing: var(--text-hero--letter-spacing);
    line-height: var(--text-hero--line-height);
  }

  .title {
    position: relative;
    z-index: 1;
    color: var(--color-on-dark);
  }

  .plates {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    user-select: none;
  }

  .plate {
    position: absolute;
    inset: 0;
    mix-blend-mode: screen;
  }

  .plate::before {
    content: attr(data-text);
  }

  .plate-cyan {
    color: var(--color-press-cyan);
    animation: plate-cyan 700ms cubic-bezier(0.16, 0.84, 0.32, 1) both;
  }

  .plate-magenta {
    color: var(--color-press-magenta);
    animation: plate-magenta 700ms cubic-bezier(0.16, 0.84, 0.32, 1) both;
  }

  .plate-yellow {
    color: var(--color-press-yellow);
    animation: plate-yellow 700ms cubic-bezier(0.16, 0.84, 0.32, 1) both;
  }

  @keyframes plate-cyan {
    from {
      transform: translate(-8px, 4px);
    }
  }

  @keyframes plate-magenta {
    from {
      transform: translate(7px, -4px);
    }
  }

  @keyframes plate-yellow {
    from {
      transform: translate(3px, 7px);
    }
  }

  /* "or call" always gets its own line, as in the ink close, so the row
     can't re-wrap when the font arrives. */
  .actions {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.75rem;
    margin-top: 1.5rem;
  }

  .buttons {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    align-self: stretch;
  }

  .buttons :global(.btn) {
    width: 100%;
  }

  /* One line per proof and as many columns as fit: 7.25rem clears the
     longest proof in either face, so the font can't change the rows. */
  .proofs {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(7.25rem, 1fr));
    gap: 0.7rem 1.25rem;
    max-width: 46rem;
    margin-top: 1.75rem;
    border-top: 1px solid rgb(255 255 255 / 0.22);
    padding-top: 1.1rem;
    font-size: 0.875rem;
    font-weight: 600;
    line-height: 1.3;
    white-space: nowrap;
  }

  .fan {
    position: relative;
    order: 2;
    height: 8.75rem;
    margin: 0.25rem 1rem 1rem;
  }

  .fan-card {
    position: absolute;
    top: 1.15rem;
    left: calc(var(--fan) * 3.45rem);
    z-index: calc(var(--fan) + 1);
    width: 5.35rem;
    transform: rotate(calc((var(--fan) - 2) * 6deg));
    filter: drop-shadow(0 10px 18px rgb(0 0 0 / 0.35));
    transition: transform 400ms ease;
  }

  .fan :global(.mark) {
    position: absolute;
    right: -0.25rem;
    bottom: 0;
    z-index: 0;
    width: 4.25rem;
    pointer-events: none;
  }

  @media (hover: hover) and (pointer: fine) {
    .fan:hover .fan-card,
    .fan:focus-within .fan-card {
      transform: translateX(calc((var(--fan) - 2) * 10px))
        rotate(calc((var(--fan) - 2) * 8deg));
    }
  }

  @media (min-width: 40rem) {
    .buttons {
      flex-direction: row;
      flex-wrap: wrap;
      align-self: flex-start;
    }

    .buttons :global(.btn) {
      width: auto;
    }
  }

  @media (min-width: 50.0625rem) {
    .hero,
    .copy {
      min-height: calc(100svh - 5.25rem);
    }

    /* Lines up with the header's max-w-6xl content edge. */
    .copy {
      width: min(34rem, 46vw);
      margin-left: max(1rem, calc((100% - 72rem) / 2 + 1rem));
      padding: 3rem 1.5rem 3rem 0;
    }

    .fan {
      position: absolute;
      top: 54%;
      right: max(1.25rem, calc((100% - 76rem) / 2));
      width: 32rem;
      height: 22rem;
      margin: 0;
      transform: translateY(-46%);
    }

    .fan-card {
      top: calc(0.75rem + var(--fan) * 1.15rem);
      left: calc(var(--fan) * 4.35rem);
      width: 10.5rem;
    }

    .fan :global(.mark) {
      right: auto;
      bottom: 0.25rem;
      left: -0.5rem;
      width: 5.5rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .plate {
      animation: none;
    }

    .fan-card {
      transition: none;
    }
  }
</style>
