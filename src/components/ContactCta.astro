---
import { QUOTE_PATH, SITE } from '../consts';

interface Props {
  /** Names the section; unique on the page. */
  id: string;
  heading: string;
  /** The line under the phone number. */
  callLine: string;
  /** The line under the email address. */
  emailLine: string;
}

const { id, heading, callLine, emailLine } = Astro.props;

// A page's closing call to action on the blue-dark field: a large "Get a
// free quote" button, then Call and Email as whole-card links. The Call card
// shows only while SITE.phone is set.
const card =
  'block rounded-card border border-on-dark-soft/35 p-5 text-left transition-colors hover:bg-white/8';
---

<section
  class="on-dark bg-brand-blue-dark px-4 py-12 text-center md:py-18"
  aria-labelledby={id}
>
  <h2
    id={id}
    class="font-display text-cta-sm font-bold text-on-dark md:text-cta"
  >
    {heading}
  </h2>
  <a href={QUOTE_PATH} class="btn btn-solid btn-lg mt-7">Get a free quote</a>
  <div class="mx-auto mt-8 grid max-w-3xl gap-4 sm:grid-cols-2">
    {
      SITE.phone && (
        <a href={`tel:${SITE.phone.e164}`} class={card}>
          <span class="text-eyebrow font-semibold uppercase text-on-dark-soft">
            Call
          </span>
          <span class="mt-2 block text-card font-semibold text-on-dark">
            {SITE.phone.display}
          </span>
          <span class="mt-1 block text-sm leading-normal text-on-dark-soft">
            {callLine}
          </span>
        </a>
      )
    }
    <a href={`mailto:${SITE.email}`} class={card}>
      <span class="text-eyebrow font-semibold uppercase text-on-dark-soft">
        Email
      </span>
      <span class="mt-2 block text-card font-semibold text-on-dark">
        {SITE.email}
      </span>
      <span class="mt-1 block text-sm leading-normal text-on-dark-soft">
        {emailLine}
      </span>
    </a>
  </div>
</section>
