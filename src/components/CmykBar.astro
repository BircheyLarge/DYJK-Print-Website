---
// The four inks as a strip, under the ink hero and every page header.
// `separated` is the homepage only: a paper gap so the key swatch doesn't
// disappear into the ink field above it. Interior headers leave it off.
interface Props {
  separated?: boolean;
}

const { separated = false } = Astro.props;
---

<div
  class:list={[separated ? 'cmyk-sep' : 'grid h-2.25 grid-cols-4']}
  aria-hidden="true"
>
  <span class="bg-press-cyan"></span>
  <span class="bg-press-magenta"></span>
  <span class="bg-press-yellow"></span>
  <span class="bg-brand-ink"></span>
</div>

<style>
  .cmyk-sep {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0.2rem;
    padding: 0.35rem 0.2rem;
    background: #fff;
  }

  .cmyk-sep span {
    height: 0.55rem;
  }
</style>
