---
import { getImage, Picture } from 'astro:assets';
import PortfolioPicture from './PortfolioPicture.astro';
import type { PortfolioItem } from '../data/portfolio';

interface Props {
  items: ReadonlyArray<PortfolioItem>;
}

const { items } = Astro.props;

// A lone example gets a full-width tile; more become a compact grid, two-up
// on phones and in the lg side column (341px wide), three-up on tablets.
const single = items.length === 1;
const thumbSizes = single
  ? '(min-width: 1152px) 341px, (min-width: 1024px) calc(33.3vw - 43px), (min-width: 640px) calc(50vw - 22px), calc(100vw - 32px)'
  : '(min-width: 1152px) 165px, (min-width: 1024px) calc(16.7vw - 27px), (min-width: 640px) calc(33.3vw - 19px), calc(50vw - 22px)';

// The enlarged view shows the whole, uncropped image up to 2000px wide (never
// upscaled). Without JavaScript the thumbnail simply links to the WebP.
const MAX_LARGE_WIDTH = 2000;
const examples = await Promise.all(
  items.map(async (item, index) => {
    // getImage() reads the size without making Astro ship the original.
    const { width = 0, height = 0 } = (await getImage({ src: item.image }))
      .options;
    const largeWidth = Math.min(width, MAX_LARGE_WIDTH);
    const ratio = width / height;
    const large = await getImage({
      src: item.image,
      width: largeWidth,
      format: 'webp',
    });
    return {
      item,
      index,
      id: `example-${index + 1}`,
      href: large.src,
      largeWidth,
      largeWidths: largeWidth > 1200 ? [1200, largeWidth] : [largeWidth],
      ratio: ratio.toFixed(4),
      // Height-bound when the viewport is wider than the image, else
      // width-bound; matches the .lightbox img rule below.
      largeSizes: `(min-aspect-ratio: ${Math.round(ratio * 1000)}/1000) calc((100vh - 7rem) * ${ratio.toFixed(4)}), calc(100vw - 3.5rem)`,
    };
  }),
);
---

<h2 class="text-sm font-semibold text-brand-ink">Examples</h2>
<ul
  role="list"
  class:list={[
    'mt-3 grid gap-3',
    single
      ? 'sm:grid-cols-2 lg:grid-cols-1'
      : 'grid-cols-2 sm:grid-cols-3 lg:grid-cols-2',
  ]}
>
  {
    examples.map((example) => (
      <li>
        <a
          href={example.href}
          data-lightbox={example.id}
          class="block rounded-card transition-opacity hover:opacity-85"
        >
          <PortfolioPicture
            item={example.item}
            sizes={thumbSizes}
            loading={example.index === 0 ? 'eager' : 'lazy'}
            fetchpriority={example.index === 0 ? 'high' : undefined}
            crop
          />
          <span class="sr-only">View larger</span>
        </a>
        <dialog
          id={example.id}
          aria-labelledby={`${example.id}-caption`}
          class="lightbox"
          style={`--ratio: ${example.ratio}; --max-width: ${example.largeWidth}px`}
        >
          <figure>
            <Picture
              src={example.item.image}
              alt={example.item.alt}
              formats={['avif', 'webp']}
              fallbackFormat="webp"
              width={example.largeWidth}
              widths={example.largeWidths}
              sizes={example.largeSizes}
              loading="lazy"
              class="rounded-lg bg-white/10"
            />
            <figcaption class="mt-3 flex items-center justify-between gap-4">
              <span id={`${example.id}-caption`} class="text-sm text-white">
                {example.item.title}
              </span>
              <form method="dialog">
                <button class="rounded-md border border-slate-600 px-4 py-2 text-sm font-semibold text-white transition-colors hover:border-white">
                  Close
                </button>
              </form>
            </figcaption>
          </figure>
        </dialog>
      </li>
    ))
  }
</ul>

<style>
  @reference '../styles/global.css';

  .lightbox {
    @apply m-auto max-h-none max-w-none rounded-card bg-brand-ink p-3;
  }
  .lightbox::backdrop {
    @apply bg-brand-ink/80;
  }
  /* Sized before the image loads, so the open dialog never jumps. */
  .lightbox :global(img) {
    width: min(
      calc(100vw - 3.5rem),
      calc((100vh - 7rem) * var(--ratio)),
      var(--max-width)
    );
    width: min(
      calc(100vw - 3.5rem),
      calc((100dvh - 7rem) * var(--ratio)),
      var(--max-width)
    );
    height: auto;
  }
</style>

<script>
  // Progressive enhancement: each thumbnail links to its large image; where
  // <dialog> is supported, show it in place instead.
  const root = document.documentElement;

  // Hold the page still behind the dialog. Padding by the scrollbar's real
  // width (0 for overlay scrollbars) keeps the layout from shifting.
  const lockScroll = () => {
    root.style.paddingRight = `${window.innerWidth - root.clientWidth}px`;
    root.style.overflow = 'hidden';
  };
  const unlockScroll = () => {
    root.style.removeProperty('padding-right');
    root.style.removeProperty('overflow');
  };

  for (const link of document.querySelectorAll<HTMLAnchorElement>(
    'a[data-lightbox]',
  )) {
    const element = document.getElementById(link.dataset.lightbox ?? '');
    if (!element || !('showModal' in element)) continue;
    const dialog = element as HTMLDialogElement;

    link.addEventListener('click', (event) => {
      // Modified clicks still open the image itself (new tab, download).
      if (
        event.button !== 0 ||
        event.metaKey ||
        event.ctrlKey ||
        event.shiftKey ||
        event.altKey
      ) {
        return;
      }
      event.preventDefault();
      lockScroll();
      dialog.showModal();
    });

    // Clicks outside the panel land on the dialog element (its backdrop).
    dialog.addEventListener('click', (event) => {
      const box = dialog.getBoundingClientRect();
      const outside =
        event.clientX < box.left ||
        event.clientX > box.right ||
        event.clientY < box.top ||
        event.clientY > box.bottom;
      if (outside) dialog.close();
    });

    dialog.addEventListener('close', () => {
      unlockScroll();
      link.focus();
    });
  }
</script>
