---
import PortfolioPicture from './PortfolioPicture.astro';
import { imagesForProduct } from '../data/portfolio';

interface Props {
  slug: string;
  title: string;
  description: string;
  /** Rendered width of the card in its grid. */
  sizes: string;
  /** h2 on the /products/ hub; h3 under a section heading. */
  headingLevel?: 2 | 3;
  loading?: 'eager' | 'lazy';
  fetchpriority?: 'high';
}

const {
  slug,
  title,
  description,
  sizes,
  headingLevel = 2,
  loading = 'lazy',
  fetchpriority,
} = Astro.props;

// The product page's lead image, so a new portfolio entry updates the card.
const lead = imagesForProduct(slug)[0];
const Heading = headingLevel === 3 ? 'h3' : 'h2';
---

<a
  href={`/products/${slug}/`}
  class="group flex flex-col overflow-hidden rounded-xl border border-slate-200 transition-shadow hover:shadow-lg"
>
  {
    lead ? (
      <PortfolioPicture
        item={lead}
        sizes={sizes}
        loading={loading}
        fetchpriority={fetchpriority}
        crop
        decorative
        flush
      />
    ) : (
      <div
        data-placeholder
        class="flex aspect-3/2 items-center justify-center bg-brand-surface text-brand-blue"
      >
        {/* No image yet: a drawn booklet holds the same 3:2 frame. */}
        <svg
          viewBox="0 0 120 80"
          class="h-1/2 w-auto"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M26 59v3c11-1.5 23-1 34 3 11-4 23-4.5 34-3v-3" />
          <path
            fill="white"
            d="M60 22c-11-4-23-4.5-34-3v40c11-1.5 23-1 34 3zM60 22c11-4 23-4.5 34-3v40c-11-1.5-23-1-34 3z"
          />
          <path d="M32 28l22 1.2M32 34l22 1.2M32 40l22 1.2M32 46l15 .8" />
          <path
            fill="currentColor"
            fill-opacity="0.15"
            d="M66 29.2l22-1.2v11l-22 1.2z"
          />
          <path d="M66 46.2l22-1.2M66 52.2l15-.8" />
        </svg>
      </div>
    )
  }
  <div class="flex flex-1 flex-col p-6">
    <Heading
      class="text-lg font-semibold text-brand-ink group-hover:text-brand-blue"
    >
      {title}
    </Heading>
    <p class="mt-2 text-sm text-brand-muted">{description}</p>
    <span class="mt-auto pt-4 text-sm font-semibold text-brand-blue">
      Learn more&nbsp;<span aria-hidden="true">→</span>
    </span>
  </div>
</a>
