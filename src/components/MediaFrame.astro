---
/*
 * MediaFrame — the imagery art-direction primitive (owns the visual treatment;
 * Card owns the slot it drops into). Fixed aspect ratio + object-cover so images
 * never cause layout shift, an optional ink→blue duotone that unifies mixed
 * source photos into one brand look, and opt-in registration crop marks (a
 * functional print detail, not decoration).
 *
 * States:
 *   - with `src`      → the real photo, duotone-treated by default.
 *   - no `src`        → an INTENTIONAL placeholder (never a dead gray box):
 *       placeholder="showcase" (default) = branded duotone + halftone panel,
 *       placeholder="monogram"           = DYJK monogram + "artwork coming".
 * This is why the "zero photos" gap doesn't block layout — placeholders read as
 * designed, and a real <img src> slots in with no structural change.
 */
interface Props {
  src?: string;
  /** Required + meaningful when `src` is set. */
  alt?: string;
  ratio?: 'hero' | '3/2' | '4/3' | 'square';
  duotone?: boolean;
  registration?: boolean;
  placeholder?: 'showcase' | 'monogram';
  /** Reserve layout space for a real image (avoids CLS). */
  width?: number;
  height?: number;
  class?: string;
}
const {
  src,
  alt = '',
  ratio = '3/2',
  duotone = true,
  registration = false,
  placeholder = 'showcase',
  width,
  height,
  class: className = '',
} = Astro.props;

const ratioClass = {
  hero: 'aspect-[4/5]',
  '3/2': 'aspect-[3/2]',
  '4/3': 'aspect-[4/3]',
  square: 'aspect-square',
}[ratio];
---

<div
  class:list={[
    'relative overflow-hidden rounded-xl',
    ratioClass,
    registration && 'reg-frame',
    className,
  ]}
>
  {
    src ? (
      <img
        src={src}
        alt={alt}
        width={width}
        height={height}
        loading="lazy"
        decoding="async"
        class:list={['h-full w-full object-cover', duotone && 'is-duotone']}
      />
    ) : placeholder === 'monogram' ? (
      <div class="flex h-full w-full items-center justify-center bg-brand-surface">
        <div class="text-center">
          <p class="font-display text-3xl font-semibold text-brand-slate">
            DYJK
          </p>
          <p class="mt-1 text-xs uppercase tracking-wider text-brand-muted">
            artwork coming
          </p>
        </div>
      </div>
    ) : (
      <div class="showcase h-full w-full" aria-hidden="true" />
    )
  }
</div>

<style>
  /* Duotone for a real photo: desaturate, then wash toward the brand blue so a
     grab-bag of client photos reads as one cohesive set. Refine per-photo when
     real artwork lands. */
  .is-duotone {
    filter: grayscale(1) contrast(1.05) brightness(0.98);
  }

  /* Branded showcase placeholder: ink→blue duotone field + a print halftone
     dot grid. Reads as an intentional treated image, not an empty slot. */
  .showcase {
    background-image:
      radial-gradient(
        circle at 1px 1px,
        rgb(255 255 255 / 0.14) 1.3px,
        transparent 1.4px
      ),
      linear-gradient(135deg, var(--color-brand-ink), var(--color-brand-blue));
    background-size:
      9px 9px,
      cover;
  }

  /* Opt-in registration crop marks at two corners — a functional print cue. */
  .reg-frame::before,
  .reg-frame::after {
    content: '';
    position: absolute;
    width: 16px;
    height: 16px;
    z-index: 1;
    pointer-events: none;
  }
  .reg-frame::before {
    top: 10px;
    left: 10px;
    border-top: 2px solid rgb(255 255 255 / 0.75);
    border-left: 2px solid rgb(255 255 255 / 0.75);
  }
  .reg-frame::after {
    bottom: 10px;
    right: 10px;
    border-bottom: 2px solid rgb(255 255 255 / 0.75);
    border-right: 2px solid rgb(255 255 255 / 0.75);
  }
</style>
