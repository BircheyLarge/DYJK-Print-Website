---
import { getImage, Picture } from 'astro:assets';
import PortfolioPicture from './PortfolioPicture.astro';
import type { PortfolioItem } from '../data/portfolio';

interface Props {
  item: PortfolioItem;
  /** Unique on the page; names the dialog. */
  id: string;
  /** Rendered width of the thumbnail; must match the grid that holds it. */
  sizes: string;
  /** Names the dialog; defaults to the piece's title. */
  caption?: string;
  loading?: 'eager' | 'lazy';
  fetchpriority?: 'high';
  /** Crop the thumbnail to the shared 3:2 frame. */
  crop?: boolean;
}

const {
  item,
  id,
  sizes,
  caption = item.title,
  loading = 'lazy',
  fetchpriority,
  crop,
} = Astro.props;

// A thumbnail in C's ruled frame (a 1px rule and a 12px mat, so the image is
// 26px narrower than its slot) that opens the whole, uncropped image in a
// dialog, up to 2000px wide (never upscaled). Without JavaScript it simply
// links to the WebP.
const MAX_LARGE_WIDTH = 2000;
// getImage() reads the size without making Astro ship the original.
const { width = 0, height = 0 } = (await getImage({ src: item.image })).options;
const largeWidth = Math.min(width, MAX_LARGE_WIDTH);
const ratio = width / height;
const large = await getImage({
  src: item.image,
  width: largeWidth,
  format: 'webp',
});
const largeWidths = largeWidth > 1200 ? [1200, largeWidth] : [largeWidth];
// Height-bound when the viewport is wider than the image, else width-bound;
// matches the .lightbox img rule below.
const largeSizes = `(min-aspect-ratio: ${Math.round(ratio * 1000)}/1000) calc((100vh - 7rem) * ${ratio.toFixed(4)}), calc(100vw - 3.5rem)`;
---

<a
  href={large.src}
  data-lightbox={id}
  class="block border border-rule bg-brand-surface p-3 [&_img]:transition-opacity hover:[&_img]:opacity-85"
>
  <PortfolioPicture
    item={item}
    sizes={sizes}
    loading={loading}
    fetchpriority={fetchpriority}
    crop={crop}
  />
  <span class="sr-only">View larger</span>
</a>
<dialog
  id={id}
  aria-labelledby={`${id}-caption`}
  class="lightbox"
  style={`--ratio: ${ratio.toFixed(4)}; --max-width: ${largeWidth}px`}
>
  <figure>
    <Picture
      src={item.image}
      alt={item.alt}
      formats={['avif', 'webp']}
      fallbackFormat="webp"
      width={largeWidth}
      widths={largeWidths}
      sizes={largeSizes}
      loading="lazy"
      class="bg-white/10"
    />
    <figcaption class="mt-3 flex items-center justify-between gap-4">
      <span id={`${id}-caption`} class="text-sm text-white">
        {caption}
      </span>
      <form method="dialog">
        <button
          class="rounded-md border border-slate-600 px-4 py-2 text-sm font-semibold text-white transition-colors hover:border-white"
        >
          Close
        </button>
      </form>
    </figcaption>
  </figure>
</dialog>

<style>
  @reference '../styles/global.css';

  .lightbox {
    @apply m-auto max-h-none max-w-none bg-brand-ink p-3;
  }
  .lightbox::backdrop {
    @apply bg-brand-ink/80;
  }
  /* Sized before the image loads, so the open dialog never jumps. */
  .lightbox :global(img) {
    width: min(
      calc(100vw - 3.5rem),
      calc((100vh - 7rem) * var(--ratio)),
      var(--max-width)
    );
    width: min(
      calc(100vw - 3.5rem),
      calc((100dvh - 7rem) * var(--ratio)),
      var(--max-width)
    );
    height: auto;
  }
</style>

<script>
  // Progressive enhancement: each thumbnail links to its large image; where
  // <dialog> is supported, show it in place instead.
  const root = document.documentElement;

  // Hold the page still behind the dialog. Padding by the scrollbar's real
  // width (0 for overlay scrollbars) keeps the layout from shifting.
  const lockScroll = () => {
    root.style.paddingRight = `${window.innerWidth - root.clientWidth}px`;
    root.style.overflow = 'hidden';
  };
  const unlockScroll = () => {
    root.style.removeProperty('padding-right');
    root.style.removeProperty('overflow');
  };

  for (const link of document.querySelectorAll<HTMLAnchorElement>(
    'a[data-lightbox]',
  )) {
    const element = document.getElementById(link.dataset.lightbox ?? '');
    if (!element || !('showModal' in element)) continue;
    const dialog = element as HTMLDialogElement;

    link.addEventListener('click', (event) => {
      // Modified clicks still open the image itself (new tab, download).
      if (
        event.button !== 0 ||
        event.metaKey ||
        event.ctrlKey ||
        event.shiftKey ||
        event.altKey
      ) {
        return;
      }
      event.preventDefault();
      lockScroll();
      dialog.showModal();
    });

    // Clicks outside the panel land on the dialog element (its backdrop).
    dialog.addEventListener('click', (event) => {
      const box = dialog.getBoundingClientRect();
      const outside =
        event.clientX < box.left ||
        event.clientX > box.right ||
        event.clientY < box.top ||
        event.clientY > box.bottom;
      if (outside) dialog.close();
    });

    dialog.addEventListener('close', () => {
      unlockScroll();
      link.focus();
    });
  }
</script>
