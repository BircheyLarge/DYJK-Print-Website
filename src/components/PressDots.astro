---
// C, M and Y dots and a K ring: the eyebrow mark on ink fields.
const dot = 'size-2.5 rounded-full';
---

<span class="inline-flex shrink-0 gap-1" aria-hidden="true">
  <span class:list={[dot, 'bg-press-cyan']}></span>
  <span class:list={[dot, 'bg-press-magenta']}></span>
  <span class:list={[dot, 'bg-press-yellow']}></span>
  <span class:list={[dot, 'ring-[1.5px] ring-on-dark ring-inset']}></span>
</span>
