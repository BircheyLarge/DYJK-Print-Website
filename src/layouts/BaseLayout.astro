---
import '../styles/global.css';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import JsonLd from '../components/JsonLd.astro';
import type { PageMetaInput } from '../lib/seo';

interface Props extends PageMetaInput {
  /** Optional JSON-LD nodes for this page. */
  schema?: Record<string, unknown> | Record<string, unknown>[];
  /** Outfit weights to preload; see BaseHead. */
  fonts?: number[];
}

const { schema, fonts, ...meta } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead {...meta} fonts={fonts} />
    {schema && <JsonLd schema={schema} />}
  </head>
  <body class="flex min-h-screen flex-col">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-[100] focus:rounded-control focus:bg-brand-blue focus:px-4 focus:py-2 focus:text-on-dark"
    >
      Skip to content
    </a>
    <Header />
    <main id="main" class="flex-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
