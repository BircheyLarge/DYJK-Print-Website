---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import { QUOTE_PATH } from '../consts';
---

<BaseLayout title="Page not found" noindex>
  <section class="mx-auto max-w-2xl px-4 py-24 text-center">
    <p class="text-sm font-semibold uppercase tracking-wider text-brand-blue">
      404
    </p>
    <h1
      class="font-display mt-4 text-4xl font-semibold tracking-tight text-brand-ink"
    >
      We couldn't find that page
    </h1>
    <p class="mt-4 text-brand-muted">
      The page may have moved. Head back home or request a quote and we'll point
      you in the right direction.
    </p>
    <div class="mt-8 flex flex-wrap justify-center gap-4">
      <Button href="/" variant="secondary">Back home</Button>
      <Button href={QUOTE_PATH} variant="outline-accent">Request a Quote</Button
      >
    </div>
  </section>
</BaseLayout>
