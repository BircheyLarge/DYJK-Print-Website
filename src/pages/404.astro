---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import { QUOTE_PATH } from '../consts';
---

<BaseLayout title="Page not found" noindex>
  <section class="mx-auto max-w-2xl px-4 py-24 text-center">
    <p class="text-sm font-semibold uppercase tracking-wider text-brand-blue">
      404
    </p>
    <h1 class="mt-4 text-4xl font-bold tracking-tight text-brand-ink">
      We couldn't find that page
    </h1>
    <p class="mt-4 text-brand-muted">
      The page may have moved. Head back home or request a quote and we'll point
      you in the right direction.
    </p>
    {
      /* "Back home" stays the filled action here even though the quote is the
        site's primary CTA everywhere else — someone who landed on a dead link
        wants their way back, not a sales form. The one screen where the
        hierarchy inverts, and deliberately. */
    }
    <div class="mt-8 flex flex-wrap justify-center gap-4">
      <Button href="/">Back home</Button>
      <Button href={QUOTE_PATH} variant="secondary">Request a Quote</Button>
    </div>
  </section>
</BaseLayout>
