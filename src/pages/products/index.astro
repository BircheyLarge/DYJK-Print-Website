---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import ProductCard from '../../components/ProductCard.astro';
import QuoteCta from '../../components/QuoteCta.astro';
import { breadcrumbSchema } from '../../lib/schema';

const products = (
  await getCollection('products', ({ data }) => !data.draft)
).sort(
  (a, b) =>
    a.data.order - b.data.order || a.data.title.localeCompare(b.data.title),
);

// Card width in the grid below: three columns from lg (357px at full width),
// two from sm, one on phones.
const cardSizes =
  '(min-width: 1152px) 357px, (min-width: 1024px) calc(33.3vw - 27px), (min-width: 640px) calc(50vw - 28px), calc(100vw - 32px)';

const schema = breadcrumbSchema([
  { name: 'Home', path: '/' },
  { name: 'Products', path: '/products/' },
]);
---

<BaseLayout
  title="Print Products"
  description="Business cards, presentation folders, postcards, stickers, labels, flyers, brochures, catalogs and stationery — printed to spec and shipped anywhere in the US."
  schema={schema}
>
  <PageHeader
    eyebrow="Products"
    title="What we print"
    subtitle="A growing catalog of print products for every campaign and brand. Don't see what you need? Just ask — if it prints, we likely make it."
  />

  <section class="mx-auto max-w-6xl px-4 py-16">
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        products.map((product, index) => (
          <ProductCard
            slug={product.id}
            title={product.data.title}
            description={product.data.description}
            sizes={cardSizes}
            loading={index < 3 ? 'eager' : 'lazy'}
            fetchpriority={index === 0 ? 'high' : undefined}
          />
        ))
      }
    </div>
  </section>

  <QuoteCta />
</BaseLayout>
