---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import CatalogGrid from '../../components/CatalogGrid.astro';
import QuoteCta from '../../components/QuoteCta.astro';
import { PRODUCTS } from '../../data/catalog';
import { breadcrumbSchema } from '../../lib/schema';

const schema = breadcrumbSchema([
  { name: 'Home', path: '/' },
  { name: 'Products', path: '/products/' },
]);
---

<BaseLayout
  title="Print Products"
  description="Business cards, brochures, flyers, catalogs, postcards, stationery and more — printed to spec and shipped anywhere in the US."
  schema={schema}
>
  <PageHeader
    eyebrow="Products"
    title="What we print"
    subtitle="A growing catalog of print products for every campaign and brand. Don't see what you need? Just ask — if it prints, we likely make it."
  />

  <section class="mx-auto max-w-6xl px-4 py-16 sm:py-20">
    <CatalogGrid items={PRODUCTS} />
  </section>

  <QuoteCta />
</BaseLayout>
