---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import QuoteCta from '../../components/QuoteCta.astro';
import Button from '../../components/Button.astro';
import { PRODUCTS, SERVICES } from '../../data/catalog';
import { QUOTE_PATH } from '../../consts';
import { breadcrumbSchema, faqSchema, serviceSchema } from '../../lib/schema';

export const getStaticPaths = (() => {
  return SERVICES.map((service) => ({
    params: { slug: service.slug },
    props: { service },
  }));
}) satisfies GetStaticPaths;

const { service } = Astro.props;

const schema = [
  serviceSchema({
    name: service.name,
    description: service.blurb,
    path: service.href,
  }),
  breadcrumbSchema([
    { name: 'Home', path: '/' },
    { name: 'Services', path: '/services/' },
    { name: service.name, path: service.href },
  ]),
  faqSchema(service.faqs),
];

// Products this service typically produces — the internal link a searcher
// landing on "offset printing" needs next ("brochures", "catalogs", ...).
const relatedProducts = PRODUCTS.filter(
  (product) => product.relatedService === service.slug,
);
---

<BaseLayout title={service.name} description={service.blurb} schema={schema}>
  <PageHeader
    eyebrow="Services"
    title={service.name}
    subtitle={service.blurb}
  />

  <div class="mx-auto max-w-6xl px-4 py-16">
    <div class="grid gap-12 lg:grid-cols-[minmax(0,1fr)_20rem] lg:gap-16">
      <div class="min-w-0">
        <p class="text-lg leading-relaxed text-brand-slate">
          {service.detail}
        </p>

        <h2 class="mt-12 text-2xl font-bold tracking-tight text-brand-ink">
          At a glance
        </h2>
        <dl class="mt-6 divide-y divide-slate-200 border-y border-slate-200">
          {
            service.specs.map((spec) => (
              <div class="grid gap-1 py-4 sm:grid-cols-[12rem_1fr] sm:gap-6">
                <dt class="text-sm font-semibold text-brand-ink">
                  {spec.label}
                </dt>
                <dd class="text-sm text-brand-slate">{spec.value}</dd>
              </div>
            ))
          }
        </dl>

        <h2 class="mt-12 text-2xl font-bold tracking-tight text-brand-ink">
          What people use it for
        </h2>
        <ul class="mt-6 space-y-3">
          {
            service.useCases.map((useCase) => (
              <li class="flex gap-3">
                <svg
                  class="mt-1 h-5 w-5 shrink-0 text-brand-blue"
                  viewBox="0 0 20 20"
                  fill="currentColor"
                  aria-hidden="true"
                >
                  <path
                    fill-rule="evenodd"
                    d="M16.7 5.3a1 1 0 0 1 0 1.4l-7.5 7.5a1 1 0 0 1-1.4 0L3.3 9.7a1 1 0 1 1 1.4-1.4l3.8 3.8 6.8-6.8a1 1 0 0 1 1.4 0Z"
                    clip-rule="evenodd"
                  />
                </svg>
                <span class="text-brand-slate">{useCase}</span>
              </li>
            ))
          }
        </ul>

        <h2 class="mt-12 text-2xl font-bold tracking-tight text-brand-ink">
          {service.name} — common questions
        </h2>
        <dl class="mt-6 space-y-8">
          {
            service.faqs.map((faq) => (
              <div>
                <dt class="text-lg font-semibold text-brand-ink">
                  {faq.question}
                </dt>
                <dd class="mt-2 leading-relaxed text-brand-slate">
                  {faq.answer}
                </dd>
              </div>
            ))
          }
        </dl>

        <p class="mt-12">
          <a
            href="/services/"
            class="text-sm font-semibold text-brand-blue hover:text-brand-blue-dark"
          >
            ← All services
          </a>
        </p>
      </div>

      <aside class="lg:pt-2">
        <div class="rounded-xl border border-slate-200 bg-brand-surface p-6">
          <h2 class="text-base font-bold text-brand-ink">
            Get a price for this
          </h2>
          <p class="mt-2 text-sm text-brand-muted">
            Send quantity, size and your deadline. We'll come back with an
            itemized quote — usually within one business day.
          </p>
          <Button href={QUOTE_PATH} size="sm" block class="mt-4">
            Request a Quote
          </Button>
        </div>

        {
          relatedProducts.length > 0 && (
            <div class="mt-6 rounded-xl border border-slate-200 p-6">
              <h2 class="text-base font-bold text-brand-ink">
                Commonly printed this way
              </h2>
              <ul class="mt-3 space-y-2">
                {relatedProducts.map((product) => (
                  <li>
                    <a
                      href={product.href}
                      class="text-sm text-brand-blue hover:text-brand-blue-dark"
                    >
                      {product.name}
                    </a>
                  </li>
                ))}
              </ul>
              <p class="mt-3">
                <a
                  href="/products/"
                  class="text-sm font-semibold text-brand-blue hover:text-brand-blue-dark"
                >
                  All products →
                </a>
              </p>
            </div>
          )
        }
      </aside>
    </div>
  </div>

  <QuoteCta heading={`Need ${service.name.toLowerCase()}?`} />
</BaseLayout>
