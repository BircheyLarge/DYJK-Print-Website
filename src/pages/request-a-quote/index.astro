---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import { SITE } from '../../consts';
import { breadcrumbSchema } from '../../lib/schema';

const schema = breadcrumbSchema([
  { name: 'Home', path: '/' },
  { name: 'Request a Quote', path: '/request-a-quote/' },
]);

// P0 ships an email-based path so the conversion flow works today. The full
// quote form (Cloudflare Function + Turnstile + R2 artwork upload) lands in P1.
const mailtoSubject = encodeURIComponent('Quote request');
const mailtoBody = encodeURIComponent(
  [
    'Project / product:',
    'Quantity:',
    'Size / specs:',
    'Deadline:',
    'Ship-to (state / ZIP):',
    'Notes:',
  ].join('\n'),
);
const mailto = `mailto:${SITE.email}?subject=${mailtoSubject}&body=${mailtoBody}`;
---

<BaseLayout
  title="Request a Quote"
  description="Tell DYJK Print about your project for a fast quote and clear production timeline — printing shipped nationwide."
  schema={schema}
>
  <PageHeader
    eyebrow="Request a Quote"
    title="Get a fast quote"
    subtitle="Share your project details and we'll come back with pricing and a production timeline. We print and ship nationwide."
  />

  <section class="mx-auto max-w-3xl px-4 pt-9 pb-14 md:pb-18">
    <p class="text-prose-sm text-brand-slate md:text-prose">
      To quote your job quickly, include the product, quantity, size/specs,
      deadline, and where it ships. Send it over and we'll take it from there.
    </p>

    <div class="mt-8 flex flex-wrap gap-3">
      <a href={mailto} class="btn btn-solid">Email your project details</a>
      {
        SITE.phone && (
          <a href={`tel:${SITE.phone.e164}`} class="btn btn-ghost">
            Call {SITE.phone.display}
          </a>
        )
      }
    </div>

    <p class="mt-6 text-sm text-brand-slate">
      An online quote form with secure artwork upload is on the way.
    </p>
  </section>
</BaseLayout>
