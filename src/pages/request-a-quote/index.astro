---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Checklist from '../../components/Checklist.astro';
import EmailActions from '../../components/EmailActions.astro';
import PageHeader from '../../components/PageHeader.astro';
import QuoteForm from '../../components/QuoteForm.astro';
import { SITE } from '../../consts';
import { SLC_PATH } from '../../data/local';
import { QUOTE_NEXT } from '../../data/quote';
import { mailtoHref, QUOTE_EMAIL } from '../../lib/email';
import { breadcrumbSchema } from '../../lib/schema';

// The quote form ships switched off. PUBLIC_QUOTE_FORM_ENABLED='true' at build
// time turns it on (POST /api/quote; see README "Quote form"); otherwise this
// is exactly the email-or-call page. Turnstile is required with it on.
const formOn = import.meta.env.PUBLIC_QUOTE_FORM_ENABLED === 'true';
const siteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY ?? '';
if (formOn && !siteKey) {
  throw new Error(
    'PUBLIC_TURNSTILE_SITE_KEY must be set when PUBLIC_QUOTE_FORM_ENABLED is true.',
  );
}

const schema = breadcrumbSchema([
  { name: 'Home', path: '/' },
  { name: 'Request a Quote', path: '/request-a-quote/' },
]);

// Copy: Content Strategist's thin-pages-copy.md. Without the form, quotes
// come in by email or phone; the page promises no upload and no date for one.
const INCLUDE = [
  { title: 'The piece.', text: 'What it is, and what it has to do.' },
  { title: 'Quantity.', text: 'How many you need.' },
  { title: 'Size.', text: 'The finished size, if you know it.' },
  { title: 'Paper or finish.', text: 'Only if you already have one in mind.' },
  {
    title: 'Your date.',
    text: 'If you have one. It is your date, not a promise from us.',
  },
  { title: 'Where it ships.', text: 'A state or ZIP.' },
];

// The email opens with the same list to fill in (src/lib/email.ts).
const mailto = mailtoHref(SITE.email, QUOTE_EMAIL);

const sectionHeading =
  'crop-mark text-h2-sm font-bold text-balance text-brand-ink md:text-h2';
---

<BaseLayout
  title="Request a Free Quote"
  description="Send DYJK Print the piece by email or phone. The quote is free, you approve a proof before it prints, and we ship anywhere in the US."
  schema={schema}
>
  {
    formOn ? (
      <>
        <PageHeader
          eyebrow="Request a Quote"
          title="Get a free quote"
          subtitle="Tell us about the job here, or email or call. The quote is free, and nothing prints until you approve it."
        />

        <div class="mx-auto grid max-w-6xl gap-12 px-4 pt-10 pb-14 md:grid-cols-[minmax(0,3fr)_minmax(0,2fr)] md:gap-16 md:pt-14 md:pb-18">
          <section aria-labelledby="quote-form-title">
            <h2 id="quote-form-title" class={sectionHeading}>
              Tell us about the job
            </h2>
            <QuoteForm siteKey={siteKey} />
          </section>

          <aside
            aria-labelledby="what-happens-next"
            class="md:sticky md:top-28 md:self-start"
          >
            <h2 id="what-happens-next" class={sectionHeading}>
              What happens next
            </h2>
            <Checklist items={QUOTE_NEXT} class="mt-6" />
            <div class="mt-10 border border-rule p-5">
              <h3 class="text-card font-semibold text-brand-ink">
                Rather email or talk?
              </h3>
              <p class="mt-1 text-sm leading-normal text-brand-slate">
                Send the same details by email, or call.
              </p>
              <a href={mailto} class="btn btn-ghost mt-4">
                Email your project details
              </a>
              <EmailActions draft={QUOTE_EMAIL} class="mt-3" />
              {SITE.phone && (
                <p class="mt-4 text-base font-medium text-brand-ink">
                  Prefer to talk?{' '}
                  <a
                    href={`tel:${SITE.phone.e164}`}
                    class="font-semibold text-brand-blue underline underline-offset-2 hover:text-brand-blue-dark"
                  >
                    {SITE.phone.display}
                  </a>
                </p>
              )}
            </div>
          </aside>
        </div>
      </>
    ) : (
      <>
        <PageHeader
          eyebrow="Request a Quote"
          title="Get a free quote"
          subtitle="Email the details, or call. The quote is free, and nothing prints until you approve it."
        />

        <div class="mx-auto grid max-w-6xl gap-12 px-4 pt-10 pb-14 md:grid-cols-2 md:gap-16 md:pt-14 md:pb-18">
          <section aria-labelledby="after-you-send">
            <h2 id="after-you-send" class={sectionHeading}>
              What happens after you send this
            </h2>
            <p class="mt-4 text-prose-sm text-pretty text-brand-slate md:text-prose">
              You email{' '}
              <a
                href={mailto}
                class="text-brand-blue underline underline-offset-2 hover:text-brand-blue-dark"
              >
                {SITE.email}
              </a>
              , or you call. There is no upload on this page. If you would
              rather talk the piece through first, use the number below. Either
              way, we read what you sent and reply with a quote. We price the
              job you described. The quote itself is free. Nothing prints until
              you approve a proof, so you see the piece before the run. A
              finished file is welcome. A logo and a rough idea are enough, and
              design help can build the file from that. Tell us the state or
              ZIP. We ship the finished job anywhere in the United States. In
              the Salt Lake City area,{' '}
              <a
                href={SLC_PATH}
                class="text-brand-blue underline underline-offset-2 hover:text-brand-blue-dark"
              >
                we deliver
              </a>
              .
            </p>
            <div class="mt-8 flex flex-col items-start gap-5">
              <div>
                <a href={mailto} class="btn btn-solid btn-lg">
                  Email your project details
                </a>
                <EmailActions draft={QUOTE_EMAIL} class="mt-3" />
              </div>
              {SITE.phone && (
                <p class="text-prose-sm font-medium text-brand-ink md:text-prose">
                  Prefer to talk?{' '}
                  <a
                    href={`tel:${SITE.phone.e164}`}
                    class="font-semibold text-brand-blue underline underline-offset-2 hover:text-brand-blue-dark"
                  >
                    {SITE.phone.display}
                  </a>
                </p>
              )}
            </div>
          </section>

          <section aria-labelledby="what-to-include">
            <h2 id="what-to-include" class={sectionHeading}>
              What to include
            </h2>
            <p class="mt-4 text-prose-sm text-pretty text-brand-slate md:text-prose">
              Send these if you have them. A logo or a rough idea is enough when
              you don't.
            </p>
            <Checklist items={INCLUDE} class="mt-6" />
          </section>
        </div>
      </>
    )
  }
</BaseLayout>
