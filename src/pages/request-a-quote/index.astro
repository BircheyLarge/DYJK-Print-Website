---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Checklist from '../../components/Checklist.astro';
import PageHeader from '../../components/PageHeader.astro';
import { SITE } from '../../consts';
import { breadcrumbSchema } from '../../lib/schema';

const schema = breadcrumbSchema([
  { name: 'Home', path: '/' },
  { name: 'Request a Quote', path: '/request-a-quote/' },
]);

// Copy: Content Strategist's thin-pages-copy.md. Quotes come in by email or
// phone; the page promises no upload and no date for one. (The full quote
// form, a Cloudflare Function with Turnstile and R2 artwork upload, is P1.)
const INCLUDE = [
  { title: 'The piece.', text: 'What it is, and what it has to do.' },
  { title: 'Quantity.', text: 'How many you need.' },
  { title: 'Size.', text: 'The finished size, if you know it.' },
  { title: 'Paper or finish.', text: 'Only if you already have one in mind.' },
  {
    title: 'Your date.',
    text: 'If you have one. It is your date, not a promise from us.',
  },
  { title: 'Where it ships.', text: 'A state or ZIP.' },
];

// The email opens with the same list to fill in.
const mailtoSubject = encodeURIComponent('Quote request');
const mailtoBody = encodeURIComponent(
  [
    'The piece:',
    'Quantity:',
    'Size:',
    'Paper or finish:',
    'Your date (if you have one):',
    'Where it ships (state or ZIP):',
    'Notes:',
  ].join('\n'),
);
const mailto = `mailto:${SITE.email}?subject=${mailtoSubject}&body=${mailtoBody}`;

const sectionHeading =
  'crop-mark text-h2-sm font-bold text-balance text-brand-ink md:text-h2';
---

<BaseLayout
  title="Request a Free Quote"
  description="Send DYJK Print the piece by email or phone. The quote is free, you approve a proof before it prints, and we ship anywhere in the US."
  schema={schema}
>
  <PageHeader
    eyebrow="Request a Quote"
    title="Get a free quote"
    subtitle="Email the details, or call. The quote is free, and nothing prints until you approve it."
  />

  <div
    class="mx-auto grid max-w-6xl gap-12 px-4 pt-10 pb-14 md:grid-cols-2 md:gap-16 md:pt-14 md:pb-18"
  >
    <section aria-labelledby="after-you-send">
      <h2 id="after-you-send" class={sectionHeading}>
        What happens after you send this
      </h2>
      <p class="mt-4 text-prose-sm text-pretty text-brand-slate md:text-prose">
        You email <a
          href={mailto}
          class="text-brand-blue underline underline-offset-2 hover:text-brand-blue-dark"
          >{SITE.email}</a
        >, or you call. There is no upload on this page. If you would rather
        talk the piece through first, use the number below. Either way, we read
        what you sent and reply with a quote. We price the job you described.
        The quote itself is free. Nothing prints until you approve a proof, so
        you see the piece before the run. A finished file is welcome. A logo and
        a rough idea are enough, and design help can build the file from that.
        Tell us the state or ZIP. We ship the finished job anywhere in the
        United States.
      </p>
      <div class="mt-8 flex flex-col items-start gap-4">
        <a href={mailto} class="btn btn-solid btn-lg">
          Email your project details
        </a>
        {
          SITE.phone && (
            <p class="text-prose-sm font-medium text-brand-ink md:text-prose">
              Prefer to talk?{' '}
              <a
                href={`tel:${SITE.phone.e164}`}
                class="font-semibold text-brand-blue underline underline-offset-2 hover:text-brand-blue-dark"
              >
                {SITE.phone.display}
              </a>
            </p>
          )
        }
      </div>
    </section>

    <section aria-labelledby="what-to-include">
      <h2 id="what-to-include" class={sectionHeading}>What to include</h2>
      <p class="mt-4 text-prose-sm text-pretty text-brand-slate md:text-prose">
        Send these if you have them. A logo or a rough idea is enough when you
        don't.
      </p>
      <Checklist items={INCLUDE} class="mt-6" />
    </section>
  </div>
</BaseLayout>
