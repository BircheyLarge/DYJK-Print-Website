---
import '../../components/drafts/drafts.css';
import BaseLayout from '../../layouts/BaseLayout.astro';
import DirectionA from '../../components/drafts/DirectionA.astro';
import DirectionB from '../../components/drafts/DirectionB.astro';
import DirectionC from '../../components/drafts/DirectionC.astro';

export function getStaticPaths() {
  if (!import.meta.env.DEV) return [];
  return [
    { params: { direction: 'a' } },
    { params: { direction: 'b' } },
    { params: { direction: 'c' } },
  ];
}

const { direction } = Astro.params;
const title =
  direction === 'a'
    ? 'Homepage direction A'
    : direction === 'b'
      ? 'Homepage direction B'
      : 'Homepage direction C';
---

<BaseLayout
  title={title}
  description="Draft homepage for review. Not for publication."
  noindex
  fonts={{ outfit: [400, 500, 600], syne: [800] }}
>
  {direction === 'a' ? <DirectionA /> : direction === 'b' ? <DirectionB /> : <DirectionC />}
</BaseLayout>
