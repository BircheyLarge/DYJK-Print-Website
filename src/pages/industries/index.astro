---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import CatalogGrid from '../../components/CatalogGrid.astro';
import QuoteCta from '../../components/QuoteCta.astro';
import { INDUSTRIES } from '../../data/catalog';
import { breadcrumbSchema } from '../../lib/schema';

const schema = breadcrumbSchema([
  { name: 'Home', path: '/' },
  { name: 'Industries', path: '/industries/' },
]);
---

<BaseLayout
  title="Industries We Serve"
  description="DYJK Print is a nationwide production partner for agencies, franchises, nonprofits, schools, events, real estate and more."
  schema={schema}
>
  <PageHeader
    eyebrow="Industries"
    title="A print partner for your industry"
    subtitle="We produce the collateral teams rely on — consistently, on deadline, and shipped wherever you operate."
  />

  <section class="mx-auto max-w-6xl px-4 py-16 sm:py-20">
    <CatalogGrid items={INDUSTRIES} />
  </section>

  <QuoteCta />
</BaseLayout>
