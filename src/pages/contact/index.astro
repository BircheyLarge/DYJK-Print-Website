---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import { QUOTE_PATH, SITE } from '../../consts';
import { breadcrumbSchema } from '../../lib/schema';

const schema = breadcrumbSchema([
  { name: 'Home', path: '/' },
  { name: 'Contact', path: '/contact/' },
]);

// Email-first; mentions phone only once SITE.phone is set.
const channels = SITE.phone ? 'email or phone' : 'email';
---

<BaseLayout
  title="Contact"
  description={`Reach DYJK Print by ${channels}, or request a quote for your nationwide print project.`}
  schema={schema}
>
  <PageHeader
    eyebrow="Contact"
    title="Let's talk about your print project"
    subtitle={`We work with clients across the country — reach us by ${channels}, or send your project details for a quote.`}
  />

  <section class="mx-auto max-w-6xl px-4 pt-9 pb-14 md:pb-18">
    <div class="max-w-3xl">
      <dl class="grid gap-8 sm:grid-cols-2">
        <div>
          <dt class="text-sm font-semibold text-brand-ink">Email</dt>
          <dd class="mt-1">
            <a
              href={`mailto:${SITE.email}`}
              class="text-lg text-brand-blue hover:text-brand-blue-dark"
            >
              {SITE.email}
            </a>
          </dd>
        </div>
        {
          SITE.phone && (
            <div>
              <dt class="text-sm font-semibold text-brand-ink">Phone</dt>
              <dd class="mt-1">
                <a
                  href={`tel:${SITE.phone.e164}`}
                  class="text-lg text-brand-blue hover:text-brand-blue-dark"
                >
                  {SITE.phone.display}
                </a>
              </dd>
            </div>
          )
        }
      </dl>

      <div class="mt-10">
        <a href={QUOTE_PATH} class="btn btn-solid">Request a Quote</a>
      </div>
    </div>
  </section>
</BaseLayout>
