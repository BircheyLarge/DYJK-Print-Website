---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import Section from '../../components/Section.astro';
import MediaFrame from '../../components/MediaFrame.astro';
import Button from '../../components/Button.astro';
import QuoteCta from '../../components/QuoteCta.astro';
import { QUOTE_PATH } from '../../consts';
import { breadcrumbSchema } from '../../lib/schema';

const schema = breadcrumbSchema([
  { name: 'Home', path: '/' },
  { name: 'Portfolio', path: '/portfolio/' },
]);

// No first-party project photos yet (arch doc §5: real, first-party proof only
// — we don't fabricate samples). Until the owner sends work photography, the
// gallery is a photo-READY grid of the categories we produce: each tile becomes
// a real captioned sample the moment an image drops into its MediaFrame `src`.
// Varied gradient angle + alternating registration keep the placeholders from
// reading as identical boxes.
const WORK = [
  {
    label: 'Business cards',
    note: 'Premium stocks & finishes',
    angle: '120deg',
  },
  {
    label: 'Brochures & flyers',
    note: 'Bi-fold, tri-fold, custom',
    angle: '150deg',
  },
  {
    label: 'Catalogs & booklets',
    note: 'Saddle-stitch & perfect-bound',
    angle: '105deg',
  },
  { label: 'Postcards & mailers', note: 'Direct-mail ready', angle: '135deg' },
  {
    label: 'Signage & large format',
    note: 'Banners, clings, displays',
    angle: '160deg',
  },
  {
    label: 'Branded stationery',
    note: 'Letterhead & envelopes',
    angle: '115deg',
  },
];
---

<BaseLayout
  title="Portfolio"
  description="A look at the commercial print DYJK Print produces nationwide — browse by project type and request relevant samples for your job."
  schema={schema}
>
  <PageHeader
    eyebrow="Portfolio"
    title="Our work"
    subtitle="The kind of print we produce for clients across the country. Browse by project type — and ask us for samples relevant to yours."
  />

  <Section tone="white">
    <ul class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        WORK.map((item, i) => (
          <li>
            <figure
              class="flex flex-col"
              style={`--showcase-angle:${item.angle}`}
            >
              <MediaFrame
                ratio="4/3"
                placeholder="showcase"
                registration={i % 2 === 0}
                class="shadow-rest"
              />
              <figcaption class="mt-3">
                <p class="font-semibold text-brand-ink">{item.label}</p>
                <p class="text-sm text-brand-muted">{item.note}</p>
              </figcaption>
            </figure>
          </li>
        ))
      }
    </ul>

    <div
      class="mt-12 rounded-xl border border-slate-200 bg-brand-surface p-8 text-center"
    >
      <h2 class="font-display text-2xl font-semibold text-brand-ink">
        Case studies are on the way
      </h2>
      <p class="mx-auto mt-3 max-w-xl text-brand-muted">
        We're curating recent projects to feature here. In the meantime, tell us
        what you're printing and we'll send physical samples and specs relevant
        to your job.
      </p>
      <div class="mt-6 flex justify-center">
        <Button href={QUOTE_PATH} variant="primary">Request samples</Button>
      </div>
    </div>
  </Section>

  <QuoteCta heading="Tell us about your project" />
</BaseLayout>
