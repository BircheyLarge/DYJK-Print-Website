---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import PortfolioPicture from '../../components/PortfolioPicture.astro';
import QuoteCta from '../../components/QuoteCta.astro';
import { PORTFOLIO, relatedService } from '../../data/portfolio';
import { breadcrumbSchema } from '../../lib/schema';

const schema = breadcrumbSchema([
  { name: 'Home', path: '/' },
  { name: 'Portfolio', path: '/portfolio/' },
]);

// Slot width in the grid below: max-w-6xl minus px-4, two columns from md
// with a gap-x-6 gutter, one full-width column under md.
const sizes =
  '(min-width: 1152px) 548px, (min-width: 768px) calc(50vw - 28px), calc(100vw - 32px)';
---

<BaseLayout
  title="Portfolio"
  description="Recent print work from DYJK Print — presentation folders, promotional cards and more, printed to spec and shipped nationwide."
  schema={schema}
>
  <PageHeader
    eyebrow="Portfolio"
    title="Our work"
    subtitle="A growing selection of recent print jobs."
  />

  <section class="mx-auto max-w-6xl px-4 py-16">
    <div class="grid gap-x-6 gap-y-12 md:grid-cols-2">
      {
        PORTFOLIO.map((item, index) => {
          const service = relatedService(item);
          // The first row sits above the fold on desktop. The service link
          // stays outside the figcaption so the figure is named by the
          // product alone.
          return (
            <div>
              <figure>
                <PortfolioPicture
                  item={item}
                  sizes={sizes}
                  loading={index < 2 ? 'eager' : 'lazy'}
                  fetchpriority={index === 0 ? 'high' : undefined}
                />
                <figcaption class="mt-4">
                  <h2 class="text-lg font-semibold text-brand-ink">
                    {item.title}
                  </h2>
                </figcaption>
              </figure>
              <a
                href={service.href}
                class="mt-1 inline-block text-sm font-semibold text-brand-blue hover:text-brand-blue-dark"
              >
                {service.name}&nbsp;<span aria-hidden="true">→</span>
              </a>
            </div>
          );
        })
      }
    </div>
  </section>

  <QuoteCta
    heading="Want to see examples like yours?"
    text="Tell us what you're printing and we'll send relevant samples and specs."
  />
</BaseLayout>
