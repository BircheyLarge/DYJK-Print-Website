---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import QuoteCta from '../../components/QuoteCta.astro';
import { breadcrumbSchema } from '../../lib/schema';

const schema = breadcrumbSchema([
  { name: 'Home', path: '/' },
  { name: 'About', path: '/about/' },
]);
---

<BaseLayout
  title="About"
  description="DYJK Print is a nationwide commercial printing partner combining production capability with hands-on design and prepress support."
  schema={schema}
>
  <PageHeader
    eyebrow="About"
    title="Your vision, our precision"
    subtitle="DYJK Print is a commercial printing partner for businesses across the United States."
  />

  <section class="mx-auto max-w-3xl px-4 py-16 sm:py-20">
    <p class="text-lg leading-relaxed text-brand-slate">
      We pair real production capability — offset and digital — with hands-on
      design and prepress support, so your project is handled end to end and
      shipped to your door, wherever you are. The full story, our equipment and
      our team are coming to this page soon.
    </p>
  </section>

  <QuoteCta />
</BaseLayout>
