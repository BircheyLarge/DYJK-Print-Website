---
import BaseLayout from '../layouts/BaseLayout.astro';
import HomeHero from '../components/HomeHero.astro';
import PortfolioPicture from '../components/PortfolioPicture.astro';
import ProductCard from '../components/ProductCard.astro';
import QuoteCta from '../components/QuoteCta.astro';
import ServiceCard from '../components/ServiceCard.astro';
import { SITE } from '../consts';
import { organizationSchema, websiteSchema } from '../lib/schema';
import { SERVICES } from '../data/catalog';
import { PORTFOLIO_GALLERY } from '../data/portfolio';
import { getProducts } from '../data/products';

const products = await getProducts();
const recentWork = PORTFOLIO_GALLERY.slice(0, 2);

// Card width in the Popular products row: four columns with 20px gaps from
// 1101px (265px at full width), three from md, two below with a 20px gap
// from sm and 16px under it.
const productSizes =
  '(min-width: 1152px) 265px, (min-width: 68.8125rem) calc(25vw - 23px), (min-width: 50.0625rem) calc(33.3vw - 24px), (min-width: 40rem) calc(50vw - 26px), calc(50vw - 24px)';

// Slot width in the Recent work grid: two columns across the max-w-6xl
// container (548px at full width; gap-4 under sm, gap-6 from sm).
const recentWorkSizes =
  '(min-width: 1152px) 548px, (min-width: 640px) calc(50vw - 28px), calc(50vw - 24px)';

const sectionHeading =
  'text-center font-display text-h2-sm font-semibold text-brand-ink md:text-h2';

const schema = [organizationSchema(), websiteSchema()];
---

<BaseLayout
  description={SITE.description}
  schema={schema}
  fonts={{ outfit: [500, 600], syne: [800] }}
>
  <HomeHero />

  <section class="bg-brand-surface py-14 md:py-18">
    <div class="mx-auto max-w-6xl px-4">
      <h2 class={sectionHeading}>Our services</h2>
      <div class="mt-10 grid gap-6 md:grid-cols-3">
        {SERVICES.map((service) => <ServiceCard service={service} />)}
      </div>
    </div>
  </section>

  <section class="py-14 md:py-18">
    <div class="mx-auto max-w-6xl px-4">
      <h2 class={sectionHeading}>Popular products</h2>
      {/* Flex rather than grid, so a short last row sits centered. */}
      <ul class="mt-10 flex flex-wrap justify-center gap-4 sm:gap-5">
        {
          products.map((product) => (
            <li class="w-[calc(50%-0.5rem)] sm:w-[calc(50%-0.625rem)] md:w-[calc((100%-2.5rem)/3)] wide:w-[calc((100%-3.75rem)/4)]">
              <ProductCard
                slug={product.id}
                title={product.data.title}
                description={product.data.description}
                sizes={productSizes}
                headingLevel={3}
                compact
              />
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="bg-brand-surface py-14 md:py-18">
    <div class="mx-auto max-w-6xl px-4">
      <h2 class={sectionHeading}>Recent work</h2>
      <div class="mt-10 grid grid-cols-2 gap-4 sm:gap-6">
        {
          recentWork.map((item) => (
            <figure>
              <PortfolioPicture item={item} sizes={recentWorkSizes} elevated />
              <figcaption class="mt-3">
                <h3 class="text-card-sm font-semibold text-brand-ink">
                  {item.title}
                </h3>
              </figcaption>
            </figure>
          ))
        }
      </div>
      <p class="mt-9 text-center">
        <a
          href="/portfolio/"
          class="text-sm font-semibold text-brand-blue hover:text-brand-blue-dark"
        >
          View our portfolio&nbsp;<span aria-hidden="true">→</span>
        </a>
      </p>
    </div>
  </section>

  <QuoteCta label="Get a free quote" />
</BaseLayout>
