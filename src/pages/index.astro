---
import BaseLayout from '../layouts/BaseLayout.astro';
import { QUOTE_PATH, SITE } from '../consts';
import { organizationSchema, websiteSchema } from '../lib/schema';

const services = [
  {
    name: 'Offset Printing',
    href: '/services/offset-printing/',
    blurb:
      'High-volume brochures, catalogs and flyers with sharp, consistent color at scale.',
  },
  {
    name: 'Digital Printing',
    href: '/services/digital-printing/',
    blurb:
      'Fast-turnaround short runs — business cards, personalized mailers and proofs.',
  },
  {
    name: 'Graphic Design & Prepress',
    href: '/services/graphic-design/',
    blurb:
      'Press-ready file prep and design support so your job prints right the first time.',
  },
];

const schema = [organizationSchema(), websiteSchema()];
---

<BaseLayout description={SITE.description} schema={schema}>
  <!-- Hero -->
  <section class="bg-brand-surface">
    <div class="mx-auto max-w-6xl px-4 py-20 text-center sm:py-28">
      <p class="text-sm font-semibold uppercase tracking-wider text-brand-blue">
        Nationwide commercial printing
      </p>
      <h1
        class="mx-auto mt-4 max-w-3xl text-4xl font-bold tracking-tight text-brand-ink sm:text-5xl"
      >
        Your Vision, Our Precision
      </h1>
      <p class="mx-auto mt-6 max-w-2xl text-lg text-brand-muted">
        Offset and digital printing, graphic design and prepress — produced to
        spec and shipped to your door anywhere in the United States.
      </p>
      <div class="mt-8 flex flex-wrap items-center justify-center gap-4">
        <a
          href={QUOTE_PATH}
          class="rounded-md bg-brand-blue px-6 py-3 text-base font-semibold text-white transition-colors hover:bg-brand-blue-dark"
        >
          Request a Quote
        </a>
        <a
          href="/services/"
          class="rounded-md border border-slate-300 px-6 py-3 text-base font-semibold text-brand-slate transition-colors hover:border-brand-blue hover:text-brand-blue"
        >
          Explore Services
        </a>
      </div>
    </div>
  </section>

  <!-- Services overview -->
  <section class="mx-auto max-w-6xl px-4 py-16">
    <h2 class="text-center text-3xl font-bold tracking-tight text-brand-ink">
      What we print
    </h2>
    <div class="mt-10 grid gap-6 md:grid-cols-3">
      {
        services.map((service) => (
          <a
            href={service.href}
            class="group rounded-xl border border-slate-200 p-6 transition-shadow hover:shadow-lg"
          >
            <h3 class="text-lg font-semibold text-brand-ink group-hover:text-brand-blue">
              {service.name}
            </h3>
            <p class="mt-2 text-sm text-brand-muted">{service.blurb}</p>
            <span class="mt-4 inline-block text-sm font-semibold text-brand-blue">
              Learn more →
            </span>
          </a>
        ))
      }
    </div>
  </section>

  <!-- CTA band -->
  <section class="bg-brand-ink">
    <div class="mx-auto max-w-6xl px-4 py-16 text-center">
      <h2 class="text-3xl font-bold tracking-tight text-white">
        Ready to start your print project?
      </h2>
      <p class="mx-auto mt-4 max-w-xl text-slate-300">
        Send us your specs and artwork. We'll get you a fast quote and a clear
        production timeline.
      </p>
      <a
        href={QUOTE_PATH}
        class="mt-8 inline-block rounded-md bg-brand-blue px-6 py-3 text-base font-semibold text-white transition-colors hover:bg-brand-blue-dark"
      >
        Request a Quote
      </a>
    </div>
  </section>
</BaseLayout>
