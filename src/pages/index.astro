---
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/Section.astro';
import Card from '../components/Card.astro';
import Button from '../components/Button.astro';
import MediaFrame from '../components/MediaFrame.astro';
import HowItWorks from '../components/HowItWorks.astro';
import TrustBar from '../components/TrustBar.astro';
import QuoteCta from '../components/QuoteCta.astro';
import { QUOTE_PATH, SITE } from '../consts';
import { organizationSchema, websiteSchema } from '../lib/schema';
import { SERVICES } from '../data/catalog';

const schema = [organizationSchema(), websiteSchema()];
---

<BaseLayout description={SITE.description} schema={schema}>
  <!-- Hero — art-direction: headline left, duotone media panel right. -->
  <Section tone="surface" size="hero">
    <div class="grid items-center gap-12 lg:grid-cols-[1.1fr_0.9fr]">
      <div>
        <p
          class="text-sm font-semibold uppercase tracking-wider text-brand-blue"
        >
          Nationwide commercial printing
        </p>
        <h1
          class="font-display mt-4 text-5xl font-semibold leading-[1.05] tracking-tight text-brand-ink sm:text-7xl"
          aria-label="Your Vision, Our Precision."
        >
          Your Vision,<br /><span class="text-accent">Our Precision.</span>
        </h1>
        <p class="mt-6 max-w-xl text-lg text-brand-slate">
          Offset and digital printing, graphic design and prepress — produced to
          spec and shipped to your door anywhere in the United States.
        </p>
        <div class="mt-8 flex flex-wrap gap-4">
          <Button href={QUOTE_PATH} variant="primary">Request a Quote</Button>
          <Button href="/services/" variant="outline">Explore Services</Button>
        </div>
      </div>
      <!-- Hidden on mobile: the headline carries small screens; the panel is a
           placeholder until real press/product photography lands. -->
      <div class="hidden lg:block">
        <MediaFrame
          ratio="hero"
          registration
          placeholder="showcase"
          class="shadow-raised"
        />
      </div>
    </div>
  </Section>

  <!-- Trust bar -->
  <TrustBar />

  <!-- Services -->
  <Section
    tone="white"
    align="center"
    eyebrow="Services"
    title="What we print"
    lead="Offset and digital printing plus in-house design and prepress — one partner, from press-ready files to your doorstep."
  >
    <div class="grid gap-6 md:grid-cols-3">
      {
        SERVICES.map((service) => (
          <Card href={service.href} title={service.name} cta="Learn more">
            {service.blurb}
          </Card>
        ))
      }
    </div>
  </Section>

  <!-- How it works -->
  <HowItWorks />

  <!-- CTA band -->
  <QuoteCta />
</BaseLayout>
