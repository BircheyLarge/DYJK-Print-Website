---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import QuoteCta from '../components/QuoteCta.astro';
import { QUOTE_PATH, SITE } from '../consts';
import { organizationSchema, websiteSchema } from '../lib/schema';
import { PRODUCTS, SERVICES } from '../data/catalog';

const schema = [organizationSchema(), websiteSchema()];

/**
 * The trust factors that decide a remote print purchase — ARCHITECTURE.md §5
 * names these explicitly: shipping, timelines, proofing, file prep, quote
 * turnaround. Without them the page asks for a lead without earning it.
 */
const TRUST = [
  {
    title: 'Shipped to all 50 states',
    body: 'Your printer does not have to be down the road. We produce here and deliver to your door, wherever that is — no pickup, no local drop-off.',
  },
  {
    title: 'A proof before anything prints',
    body: 'You see and approve the job before it goes on press. Nothing gets produced off an unapproved file.',
  },
  {
    title: 'Prepress that catches problems',
    body: 'We check bleeds, resolution, fonts and color before the run — and tell you what needs fixing rather than printing it wrong.',
  },
  {
    title: 'A real timeline with the quote',
    body: "Every quote comes with production and shipping dates, so you know what you're committing to before you approve.",
  },
];

const STEPS = [
  {
    title: 'Send your specs',
    body: 'Product, quantity, deadline and destination. Two minutes, no account.',
  },
  {
    title: 'Get a quote',
    body: 'An itemized price and a production timeline, usually within one business day.',
  },
  {
    title: 'Approve your proof',
    body: 'We prep the files and send a proof. You sign off before we print.',
  },
  {
    title: 'We print and ship',
    body: 'Produced to spec and delivered to your address anywhere in the US.',
  },
];
---

<BaseLayout description={SITE.description} schema={schema}>
  <!-- Hero -->
  <section class="border-b border-slate-200 bg-brand-surface">
    <div class="mx-auto max-w-6xl px-4 py-20 text-center sm:py-28">
      <p class="text-sm font-semibold uppercase tracking-wider text-brand-blue">
        Nationwide commercial printing
      </p>
      <h1
        class="mx-auto mt-4 max-w-3xl text-4xl font-bold tracking-tight text-brand-ink sm:text-5xl"
      >
        Your Vision, Our Precision
      </h1>
      <p class="mx-auto mt-6 max-w-2xl text-lg text-brand-muted">
        Offset and digital printing, graphic design and prepress — produced to
        spec and shipped to your door anywhere in the United States.
      </p>
      <div class="mt-8 flex flex-wrap items-center justify-center gap-4">
        <Button href={QUOTE_PATH}>Request a Quote</Button>
        <Button href="/products/" variant="secondary">See what we print</Button>
      </div>
      <p class="mt-6 text-sm text-brand-muted">
        Quotes usually back within one business day · Proof before every run
      </p>
    </div>
  </section>

  <!-- Services -->
  <section class="mx-auto max-w-6xl px-4 py-16 sm:py-20">
    {
      /* Left-aligned like every other section heading — only the hero and the
        closing CTA are centered. */
    }
    <h2 class="text-3xl font-bold tracking-tight text-brand-ink">
      How we print
    </h2>
    <p class="mt-2 text-brand-muted">
      Two presses and a prepress team, matched to the job.
    </p>
    <div class="mt-10 grid gap-6 md:grid-cols-3">
      {
        SERVICES.map((service) => (
          <a
            href={service.href}
            class="group rounded-xl border border-slate-200 p-6 transition-shadow hover:shadow-lg"
          >
            <h3 class="text-lg font-semibold text-brand-ink group-hover:text-brand-blue">
              {service.name}
            </h3>
            <p class="mt-2 text-sm text-brand-muted">{service.blurb}</p>
            <span class="mt-4 inline-block text-sm font-semibold text-brand-blue">
              Learn more →
            </span>
          </a>
        ))
      }
    </div>
  </section>

  <!-- Products: concrete commercial intent, and the internal links that carry it -->
  <section class="border-y border-slate-200 bg-brand-surface">
    <div class="mx-auto max-w-6xl px-4 py-16 sm:py-20">
      <div
        class="flex flex-wrap items-end justify-between gap-4 border-b border-slate-200 pb-6"
      >
        <div>
          <h2 class="text-3xl font-bold tracking-tight text-brand-ink">
            What we print
          </h2>
          <p class="mt-2 text-brand-muted">
            Specs, options and pricing guidance for each.
          </p>
        </div>
        <a
          href="/products/"
          class="text-sm font-semibold text-brand-blue hover:text-brand-blue-dark"
        >
          All products →
        </a>
      </div>
      <ul class="mt-8 grid gap-x-8 gap-y-4 sm:grid-cols-2 lg:grid-cols-3">
        {
          PRODUCTS.map((product) => (
            <li>
              <a
                href={product.href}
                class="group flex items-baseline justify-between gap-4 rounded-md border-b border-slate-200 py-3
                       transition-colors hover:border-brand-blue"
              >
                <span class="font-semibold text-brand-ink group-hover:text-brand-blue">
                  {product.name}
                </span>
                <span
                  class="text-brand-blue opacity-0 transition-opacity
                         group-hover:opacity-100 group-focus-visible:opacity-100"
                  aria-hidden="true"
                >
                  →
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Trust: the objections a remote print buyer actually has -->
  <section class="mx-auto max-w-6xl px-4 py-16 sm:py-20">
    <h2 class="max-w-2xl text-3xl font-bold tracking-tight text-brand-ink">
      Buying print from anywhere, without the guesswork
    </h2>
    <p class="mt-3 max-w-2xl text-brand-muted">
      The hard part of ordering print remotely is not the printing — it's
      knowing the file is right, the date is real and the boxes will arrive.
    </p>
    <div class="mt-10 grid gap-8 sm:grid-cols-2">
      {
        TRUST.map((item) => (
          <div class="border-l-2 border-brand-blue pl-5">
            <h3 class="font-semibold text-brand-ink">{item.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-brand-muted">
              {item.body}
            </p>
          </div>
        ))
      }
    </div>
  </section>

  <!-- Process -->
  <section class="border-t border-slate-200">
    <div class="mx-auto max-w-6xl px-4 py-16 sm:py-20">
      <h2 class="text-3xl font-bold tracking-tight text-brand-ink">
        How it works
      </h2>
      <ol class="mt-10 grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
        {
          STEPS.map((step, i) => (
            <li>
              <span
                class="flex h-9 w-9 items-center justify-center rounded-full bg-brand-blue text-sm font-bold text-white"
                aria-hidden="true"
              >
                {i + 1}
              </span>
              <h3 class="mt-4 font-semibold text-brand-ink">{step.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-brand-muted">
                {step.body}
              </p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <QuoteCta />
</BaseLayout>
